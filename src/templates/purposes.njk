{# Каталог по назначению (редизайн с нуля, 2026-10-17): оставлен только вариант 1 (выбор владельца 2026-10-19), переключатель и второй вариант убраны. #}
{# Вариант 1: секция на весь экран, сетка в стык от края до края окна на 12 колонках. #}
{# Первая строка: акцентный блок с заголовком (колонки 1–4) и две плитки по 4 колонки, вторая строка: четыре плитки по 3 колонки. Фото крупные, чёрно-белые, при наведении возвращается цвет и кадр слегка следует за курсором (scripts/modules/purposes.ts). #}
{% from "icons.njk" import icon %}
{% from "plural.njk" import plural %}
<section class="purposes" aria-labelledby="purposes-title" data-purposes data-chapter="Назначение">
  <div class="purposes__grid">
    <div class="purposes__intro">
      <h2 class="section-title purposes__title" id="purposes-title" data-split>Каталог<br />по назначению</h2>
      <div class="purposes__foot">
        <p class="purposes__text">{{ home.catalogTotals.total }} {{ plural(home.catalogTotals.total, "модель", "модели", "моделей") }}. Выберите груз, а подходящую технику найдём в каталоге.</p>
        <a class="button purposes__button" href="/catalog.html">Весь каталог</a>
      </div>
    </div>
    {% for item in home.purposes %}
      <a class="purposes__tile" href="{{ item.url }}" data-tile>
        <span class="purposes__photo" aria-hidden="true">
          <img
            class="purposes__image"
            src="/src/assets/models/{{ item.photo }}"
            width="2400"
            height="1600"
            alt=""
            {% if not loop.first %}loading="lazy"{% endif %}
          />
        </span>
        <span class="purposes__count">
          <span class="purposes__number">{{ item.count }}</span>
          <span class="purposes__unit">{{ plural(item.count, "модель", "модели", "моделей") }}</span>
        </span>
        {{ icon("arrow", "purposes__icon") }}
        <span class="purposes__name">{{ item.title }}</span>
      </a>
    {% endfor %}
  </div>
</section>

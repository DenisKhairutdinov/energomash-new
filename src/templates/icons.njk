{# Иконки линией, наследуют цвет текста. Использование: {{ icon("arrow") }} #}
{% macro icon(name, class="icon") %}
  {%- if name == "arrow" -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 12h15M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/></svg>
  {%- elif name == "arrow-left" -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 12H5M11 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/></svg>
  {%- elif name == "plus" -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 4v16M4 12h16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/></svg>
  {%- elif name == "close" -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 5l14 14M19 5L5 19" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/></svg>
  {%- elif name == "phone" -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 4h4l1.5 4.5-2 1.5a11 11 0 0 0 5.5 5.5l1.5-2L20 15v4a1 1 0 0 1-1 1A15 15 0 0 1 4 5a1 1 0 0 1 1-1z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
  {%- elif name == "check" -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square"/></svg>
  {%- elif name == "menu" -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 8h16M4 16h16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/></svg>
  {%- endif -%}
{% endmacro %}

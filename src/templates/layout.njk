<!doctype html>
<html lang="ru" data-theme="light"{% if pageClass %} data-page="{{ pageClass }}"{% endif %}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ pageTitleFull or (pageTitle if ("Энергомаш" in pageTitle) else (pageTitle + " — Энергомаш")) }}</title>
    {% if pageDescription %}<meta name="description" content="{{ pageDescription }}" />{% endif %}
    {# Служебные страницы и оболочка карточки модели не индексируются; страницы моделей создаёт scripts/prerender-models.mjs #}
    {% if pageRobots %}<meta name="robots" content="{{ pageRobots }}" />{% endif %}
    {% set seoTitle = pageTitleFull or (pageTitle if ("Энергомаш" in pageTitle) else (pageTitle + " — Энергомаш")) %}
    {% if pagePath %}
      <link rel="canonical" href="{{ site.url }}{{ pagePath }}" />
      <meta property="og:url" content="{{ site.url }}{{ pagePath }}" />
    {% endif %}
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:type" content="{{ 'article' if pageClass == 'article' else 'website' }}" />
    <meta property="og:title" content="{{ seoTitle }}" />
    {% if pageDescription %}<meta property="og:description" content="{{ pageDescription }}" />{% endif %}
    <meta property="og:image" content="{{ site.url }}{{ pageImage or site.ogImage }}" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#fcfdfe" />
    <link rel="icon" href="/src/assets/favicon.svg" type="image/svg+xml" />
    {# Прелоадер показываем на главной один раз за сессию #}
    <script>
      ;(function () {
        var root = document.documentElement
        root.classList.add('js')
        if (root.dataset.page === 'home' && !location.hash) {
          var repeatIntro = new URLSearchParams(location.search).get('intro') === '1'
          var seenIntro = false
          try { seenIntro = sessionStorage.getItem('energomash-intro-v1') === 'seen' } catch (error) { /* storage disabled */ }
          if (repeatIntro || !seenIntro) {
            root.setAttribute('data-intro-pending', '')
            window.setTimeout(function () {
              root.removeAttribute('data-intro-pending')
              root.removeAttribute('data-intro-revealing')
            }, 9000)
          }
        }
        try {
          var theme = localStorage.getItem('theme')
          if (theme === 'light' || theme === 'dark') root.dataset.theme = theme
        } catch (error) {
          /* без localStorage остаётся светлая тема */
        }
      })()
    </script>
    <link rel="stylesheet" href="/src/styles/main.scss" />
    <script type="module" src="/src/scripts/main.ts"></script>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "{{ site.name }}",
        "legalName": "{{ site.legalName }}",
        "url": "{{ site.url }}",
        "logo": "{{ site.url }}{{ site.logo }}",
        "email": "{{ site.email }}",
        "telephone": "{{ site.phone }}",
        "contactPoint": [{ "@type": "ContactPoint", "telephone": "{{ site.phone }}", "contactType": "sales", "areaServed": "RU", "availableLanguage": "Russian" }],
        "address": [
          {% for office in site.offices %}{ "@type": "PostalAddress", "addressLocality": "{{ office.city }}", "streetAddress": "{{ office.street }}", "addressRegion": "{{ office.region }}", "addressCountry": "RU" }{% if not loop.last %},{% endif %}{% endfor %}
        ]
      }
    </script>
    {% if pageClass == "home" %}
      {# Поле поиска по каталогу для расширенного сниппета; поиск принимает запрос в параметре q #}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "WebSite",
          "name": "{{ site.name }}",
          "url": "{{ site.url }}/",
          "inLanguage": "ru",
          "potentialAction": { "@type": "SearchAction", "target": { "@type": "EntryPoint", "urlTemplate": "{{ site.url }}/catalog.html?q={search_term_string}" }, "query-input": "required name=search_term_string" }
        }
      </script>
    {% endif %}
  </head>
  <body class="page{% if pageClass %} page--{{ pageClass }}{% endif %}">
    <a class="skip-link" href="#main">Перейти к содержимому</a>
    {% if pageClass == "home" %}{% include "intro.njk" %}{% endif %}
    {% include "header.njk" %}
    <main id="main">
      {% block content %}{% endblock %}
    </main>
    {% if pageClass != "home" %}{% include "request.njk" %}{% endif %}
    {% include "footer.njk" %}
    {% include "modal-request.njk" %}
  </body>
</html>

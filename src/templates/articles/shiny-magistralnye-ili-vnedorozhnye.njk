  <thead><tr><th>Параметр</th><th>Магистральные</th><th>Внедорожные</th></tr></thead>
  <tbody>
    <tr><td>Покрытие</td><td>Асфальт, бетон</td><td>Грунт, глина, зимники</td></tr>

{# Техника в наличии: заголовок и управление сверху, ниже широкая сцена с кадром и стеклянной подписью модели. 5 моделей и финальный слайд «Ещё N моделей», всего 6 слайдов. #}
{# Слайды листаются сами (data-autoplay, секунд на слайд) и стрелками (scripts/modules/slider.ts). Данные: src/data/home.json, ключ stock. #}
{% from "icons.njk" import icon %}
{% set slides = home.stock.length + 1 %}
{% set restCount = home.catalogTotals.inStock - home.stock.length %}
<section class="stock" id="stock" aria-labelledby="stock-title" data-slider data-autoplay="6" data-chapter="Наличие">
  <div class="stock__top container">
    <h2 class="section-title" id="stock-title" data-split>Техника<br />в наличии</h2>
    <div class="stock__aside">
      <p class="stock__lead"><strong class="stock__count">{{ home.catalogTotals.inStock }}</strong> единицы на складе. Готовые полуприцепы-цистерны и автоцистерны, отгружаем в течение нескольких дней.</p>
      <div class="stock__controls">
        <a class="button" href="/catalog.html?in-stock=1">Смотреть всё наличие</a>
        <div class="stock__nav">
          <button class="stock__arrow" type="button" aria-label="Предыдущая модель" data-prev>{{ icon("arrow-left") }}</button>
          <span class="stock__position mono" aria-live="off"><span data-current>1</span> / {{ slides }}</span>
          <button class="stock__arrow" type="button" aria-label="Следующая модель" data-next>{{ icon("arrow") }}</button>
        </div>
      </div>
    </div>
  </div>

  <div class="stock__stage">
    <div class="stock__viewport" role="group" aria-roledescription="карусель" aria-label="Техника в наличии">
      {% for item in home.stock %}
        <article class="stock__slide{{ ' is-active' if loop.first }}" data-slide aria-roledescription="слайд" aria-label="{{ loop.index }} из {{ slides }}">
          <img
            class="stock__image"
            src="/src/assets/models/{{ item.photo }}"
            width="2400"
            height="1600"
            alt="{{ item.type }} {{ item.model }}"
            {% if not loop.first %}loading="lazy"{% endif %}
            decoding="async"
          />
          <a class="stock__panel glass glass--strong" href="/product.html" aria-label="{{ item.type }} {{ item.model }}: подробнее">
            <span class="stock__panel-head">
              <span class="stock__badge mono">{{ item.badge }}</span>
              <span class="stock__type">{{ item.type }}</span>
              <span class="stock__model">{{ item.model }}</span>
            </span>
            <span class="stock__specs">
              {% for spec in item.specs %}
                <span class="stock__spec">
                  <span class="stock__spec-label mono">{{ spec[0] }}</span>
                  <span class="stock__spec-value">{{ spec[1] }}</span>
                </span>
              {% endfor %}
            </span>
            {{ icon("arrow", "stock__panel-icon") }}
          </a>
        </article>
      {% endfor %}
      <article class="stock__slide stock__slide--rest" data-slide aria-roledescription="слайд" aria-label="{{ slides }} из {{ slides }}">
        <a class="stock__rest" href="/catalog.html?in-stock=1">
          <span class="stock__rest-label mono">Вся техника на складе</span>
          <span class="stock__rest-title">Ещё {{ restCount }} моделей</span>
          {{ icon("arrow", "stock__rest-icon") }}
        </a>
      </article>
    </div>
  </div>
</section>

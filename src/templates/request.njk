{% from "icons.njk" import icon %}
{# Заявка: фото на весь экран под затемнением, огромное заявление, форма на стекле с быстрым выбором типа техники и груза. #}
<section class="request" id="request" aria-labelledby="request-title" data-chapter="Заявка">
  <img class="request__bg" src="/src/assets/models/IMG_4496.webp" width="2400" height="1600" alt="" loading="lazy" data-parallax="0.05" />
  <div class="request__layout container">
    <h2 class="request__title" id="request-title" data-split>Расскажите<br />о задаче</h2>
    <div class="request__bottom">
      <div class="request__intro">
        <p class="request__lead">Какой груз возите, на каком шасси и в каком регионе работаете. Подберём модель и пришлём предложение с ценой и сроками.</p>
        <ul class="request__contacts">
          <li><a class="request__phone" href="{{ home.contacts.phoneHref }}">{{ home.contacts.phone }}</a></li>
          <li><a class="request__mail" href="mailto:{{ home.contacts.email }}">{{ home.contacts.email }}</a></li>
        </ul>
      </div>
      <form class="request__form glass" action="#" method="post" novalidate data-request-form>
        <input type="hidden" name="kind" value="request" />
        <input type="hidden" name="model" value="" />
        <fieldset class="request__group">
          <legend class="request__legend mono">Тип техники</legend>
          <div class="request__chips">
            {% for type in home.picker.types %}
              <label class="chip">
                <input class="chip__input" type="radio" name="type" value="{{ type.value }}" />
                <span class="chip__label">{{ type.title }}</span>
              </label>
            {% endfor %}
          </div>
        </fieldset>
        <fieldset class="request__group">
          <legend class="request__legend mono">Что возите</legend>
          <div class="request__chips">
            {% for item in home.purposes %}
              <label class="chip">
                <input class="chip__input" type="checkbox" name="cargo" value="{{ item.title }}" />
                <span class="chip__label">{{ item.title }}</span>
              </label>
            {% endfor %}
          </div>
        </fieldset>
        <div class="request__fields">
          <label class="field">
            <span class="field__label">Имя</span>
            <input class="field__control" type="text" name="name" autocomplete="name" />
          </label>
          <label class="field">
            <span class="field__label">Телефон <span aria-hidden="true">*</span></span>
            <input class="field__control" type="tel" name="phone" inputmode="tel" autocomplete="tel" placeholder="+7 (___) ___-__-__" required aria-describedby="request-phone-error" />
            <span class="field__error" id="request-phone-error" hidden data-error="phone">Укажите телефон, чтобы мы могли перезвонить</span>
          </label>
          <label class="field field--wide">
            <span class="field__label">Задача</span>
            <textarea class="field__control field__control--area" name="comment" rows="3" placeholder="Объём, шасси, регион"></textarea>
          </label>
        </div>
        <div class="request__footer">
          <label class="check">
            <input class="check__input" type="checkbox" name="consent" required />
            <span class="check__box" aria-hidden="true">{{ icon("check") }}</span>
            <span class="check__text">Согласен на <a href="/privacy.html" target="_blank" rel="noopener">обработку персональных данных</a></span>
          </label>
          <span class="field__error" hidden data-error="consent">Нужно согласие на обработку данных</span>
          <button class="button" type="submit">Отправить заявку</button>
        </div>
        <p class="request__done" hidden data-form-done role="status">Заявка отправлена. Мы свяжемся с вами в ближайшее рабочее время.</p>
      </form>
    </div>
  </div>
</section>

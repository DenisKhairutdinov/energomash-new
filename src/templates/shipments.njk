{# Отгрузки: данные-заглушки (модели, города, даты), позже придут из БД. Ключ shipments в src/data/home.json #}
{# Вариант 2: горизонтальная «киноплёнка» с пином (scripts/modules/cinema.ts); вариант 1: бенто-сетка. #}
{% from "icons.njk" import icon %}
<section class="shipments" aria-labelledby="shipments-title" data-shipments data-chapter="Отгрузки">
  <div class="shipments__pin" data-shipments-pin>
    <div class="shipments__head container">
      <h2 class="section-title" id="shipments-title" data-split>Недавно<br />отгружено</h2>
      <p class="section-head__text">Свежие поставки заказчикам: модели, города и даты отгрузки.</p>
      <a class="button button--ink" href="/shipments.html">Все отгрузки</a>
    </div>
    <div class="shipments__viewport">
      <ul class="shipments__grid" data-shipments-track>
        {% for item in home.shipments %}
          <li class="shipments__item">
            <a class="shipments__link" href="/product.html">
              <span class="shipments__frame">
                <img
                  class="shipments__image"
                  src="/src/assets/images/{{ item.image }}"
                  width="1800"
                  height="1350"
                  alt="{{ item.type }} {{ item.model }}"
                  loading="lazy"
                  decoding="async"
                  data-parallax-img
                />
              </span>
              <span class="shipments__where glass glass--clear mono">
                <time datetime="{{ item.datetime }}">{{ item.date }}</time>, {{ item.city }}
              </span>
              <span class="shipments__info glass glass--strong">
                <span class="shipments__type mono">{{ item.type }}</span>
                <span class="shipments__model">{{ item.model }}</span>
                <span class="shipments__details">
                  <span class="shipments__specs">
                    {% for spec in item.specs %}
                      <span class="shipments__spec"><span class="mono">{{ spec[0] }}</span><span>{{ spec[1] }}</span></span>
                    {% endfor %}
                  </span>
                </span>
              </span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>

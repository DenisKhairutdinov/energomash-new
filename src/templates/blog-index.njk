{# Блог (страница списка): шапка с фото, фильтр по рубрикам (modules/blog.ts, адрес blog.html?rubric=…), сетка статей в стык, первая крупная. Данные: src/data/blog.json. #}
{% from "plural.njk" import plural %}
<div class="ip bl" data-blog>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "Блог завода «Энергомаш»",
      "url": "{{ site.url }}/blog.html",
      "inLanguage": "ru",
      "hasPart": [
        {% for post in blog.posts %}{ "@type": "Article", "headline": "{{ post.title }}", "url": "{{ site.url }}{{ post.url }}", "datePublished": "{{ post.datetime }}" }{% if not loop.last %},{% endif %}{% endfor %}
      ]
    }
  </script>
  <header class="ip__head ip__head--plain ip__head--mega">
    <div class="ip__head-in">
      <div class="ip__head-main">
        <p class="ip__kicker"><span>{{ blog.posts | length }} {{ plural(blog.posts | length, "статья", "статьи", "статей") }}</span><span>{{ blog.rubrics | length }} рубрик</span></p>
        <h1 class="ip__title" data-split>Блог</h1>
      </div>
      <div class="ip__head-side">
        <p class="ip__lead">Статьи завода о цистернах: как выбрать технику, из чего она состоит, как её обслуживать и перевозить опасные грузы по правилам.</p>
      </div>
    </div>
  </header>

  <div class="bl__filter" role="group" aria-label="Рубрики блога" data-blog-filter>
    <button class="bl__chip is-active" type="button" data-rubric="all">Все статьи<span class="bl__chip-n">{{ blog.posts | length }}</span></button>
    {% for rubric in blog.rubrics %}
      <button class="bl__chip" type="button" data-rubric="{{ rubric.id }}">{{ rubric.title }}<span class="bl__chip-n">{{ rubric.count }}</span></button>
    {% endfor %}
  </div>

  <ul class="bl__list" data-blog-list>
    {% for post in blog.posts | sort(true, false, "datetime") %}
      <li data-rubric="{{ post.rubricId }}">
        <a class="bl__card" href="{{ post.url }}">
          <img class="bl__image" src="/src/assets/models/thumbs/{{ post.cover }}" width="1200" height="800" alt="" {% if not loop.first %}loading="lazy"{% endif %} decoding="async" />
          <span class="bl__meta"><time datetime="{{ post.datetime }}">{{ post.dateShort }}</time> · {{ post.rubric }}</span>
          <span class="bl__text">
            <span class="bl__title">{{ post.title }}</span>
            <span class="bl__excerpt">{{ post.excerpt }}</span>
          </span>
        </a>
      </li>
    {% endfor %}
  </ul>

</div>

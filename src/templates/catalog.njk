{# Каталог: на широких экранах фильтры слева от моделей, на узких — над ними. #}
{# Карточка одна и та же для двух видов (сетка и список), различает их атрибут data-view у списка. #}
{# Данные: src/data/catalog.json (переменная catalog: типы и описание фильтров) и public/data/catalog.json (модели). #}
{# Фильтрация, чтение параметров из адреса и порционный вывод карточек: scripts/modules/catalog.ts #}
{% from "icons.njk" import icon %}
{% from "plural.njk" import plural %}

{# Список значений чипами. Значения, которых нет у выбранного типа техники, скрывает скрипт; счётчик считает скрипт #}
{% macro chips(group) %}
  <div class="cfilter__options">
    {% for option in group.options %}
      <label class="chip" data-catalog-option>
        <input class="chip__input" type="checkbox" name="{{ group.name }}" value="{{ option.value }}" />
        <span class="chip__label"><span data-filter-option-label>{{ option.label }}</span><span class="chip__n" data-chip-count></span></span>
      </label>
    {% endfor %}
  </div>
{% endmacro %}

{# Группа с types относится к одному типу техники и показывается, когда он выбран #}
{% macro group(group) %}
  {% set groupTypes = group.types | join(" ") %}
  {% if group.kind == "range" %}
    <fieldset class="cfilter__block cfilter__block--volume">
      <legend class="cfilter__label">{{ group.label }}</legend>
      <div class="cfilter__range">
        <label class="cfilter__range-field">
          <span class="cfilter__range-prefix">от</span>
          <input
            class="cfilter__range-input"
            type="text"
            name="{{ group.name }}-from"
            inputmode="numeric"
            maxlength="3"
            autocomplete="off"
            placeholder="{{ group.min }}"
            aria-label="{{ group.label }}, от"
          />
        </label>
        <label class="cfilter__range-field">
          <span class="cfilter__range-prefix">до</span>
          <input
            class="cfilter__range-input"
            type="text"
            name="{{ group.name }}-to"
            inputmode="numeric"
            maxlength="3"
            autocomplete="off"
            placeholder="{{ group.max }}"
            aria-label="{{ group.label }}, до"
          />
          <span class="cfilter__range-unit">{{ group.unit }}</span>
        </label>
      </div>
    </fieldset>
  {% elif group.name == "purpose" or group.name == "stock" %}
    <fieldset class="cfilter__block" data-catalog-group>
      <legend class="cfilter__label">{{ group.label }}</legend>
      {{ chips(group) }}
    </fieldset>
  {% else %}
    <fieldset
      class="cfilter__block cfilter__block--dropdown"
      data-catalog-group
      {% if groupTypes %}data-catalog-types="{{ groupTypes }}" hidden disabled{% endif %}
    >
      <legend class="visually-hidden">{{ group.label }}</legend>
      <button class="cfilter__trigger" type="button" aria-expanded="false" aria-controls="filter-options-{{ group.name }}" data-filter-trigger>
        <span class="cfilter__trigger-text">
          <span>{{ group.label }}</span>
          <span class="cfilter__selected" data-filter-selected></span>
        </span>
        <svg class="cfilter__chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
      <button class="cfilter__clear" type="button" aria-label="Очистить: {{ group.label }}" data-filter-clear hidden>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
      </button>
      <div class="cfilter__dropdown" id="filter-options-{{ group.name }}" hidden>
        {{ chips(group) }}
      </div>
    </fieldset>
  {% endif %}
{% endmacro %}

<div class="catalog">
  {# Шапка страницы: сплошной акцентный блок на всю ширину, огромный заголовок, пояснение и счётчик найденного #}
  <header class="catalog__head">
    <div class="catalog__head-in">
      <h1 class="catalog__title" data-split>Каталог</h1>
      <div class="catalog__head-side">
        <p class="catalog__lead">Полуприцепы-цистерны и автоцистерны завода. Выберите тип, назначение и объём: список пересчитывается сразу.</p>
        <p class="catalog__found" aria-live="polite"><strong data-catalog-count>{{ catalog.total }} {{ plural(catalog.total, "модель", "модели", "моделей") }}</strong></p>
      </div>
    </div>
  </header>

  <div class="catalog__layout">
    {# На широких экранах фильтр расположен слева от результатов. #}
    <aside class="cside" aria-label="Фильтр каталога">
      <h2 class="cside__title">Фильтры</h2>
      <form class="cfilter" id="catalog-filter" action="/catalog.html" data-catalog-filter>
        <div class="cside__types" role="radiogroup" aria-label="Тип техники">
          {% for type in catalog.types %}
            <label class="ctype">
              <input class="ctype__input" type="radio" name="type" value="{{ type.id }}" {% if loop.first %}checked{% endif %} />
              <span class="ctype__body">
                <span class="ctype__title">{{ type.label }}</span>
                <span class="ctype__count" data-type-count="{{ type.id }}">{{ type.count }} {{ plural(type.count, "модель", "модели", "моделей") }}</span>
              </span>
            </label>
          {% endfor %}
        </div>

        <div class="cfilter__bar" data-filter-bar>
          <div class="cfilter__quick">
            {% for item in catalog.filters %}
              {% if item.name == "purpose" %}{{ group(item) }}{% endif %}
            {% endfor %}
          </div>
          <div class="cfilter__tools">
            {% for item in catalog.filters %}
              {% if item.name == "stock" %}{{ group(item) }}{% endif %}
            {% endfor %}
          </div>
        </div>

        {# Все параметры постоянно доступны в боковом фильтре. #}
        <div class="cfilter__extra-wrap">
          <div class="cfilter__extra" data-catalog-extra>
            {% for item in catalog.filters %}
              {% if item.name != "purpose" and item.name != "stock" %}{{ group(item) }}{% endif %}
            {% endfor %}
          </div>
        </div>

        {# Выбранные параметры, количество найденных моделей и сброс. #}
        <div class="cfilter__status">
          <ul class="cfilter__active" aria-label="Выбранные параметры" data-active-list></ul>
          <p class="cfilter__found" aria-live="polite">
            Найдено: <strong data-catalog-count>{{ catalog.total }} {{ plural(catalog.total, "модель", "модели", "моделей") }}</strong>
          </p>
          <button class="cfilter__reset" type="reset" disabled data-catalog-reset>Сбросить всё</button>
        </div>
      </form>
    </aside>

    <div class="catalog__results">
      <div class="catalog__toolbar">
        <span class="catalog__results-label">Модели</span>
        <label class="csort">
          <span class="visually-hidden" id="catalog-sort-label">Сортировка</span>
          <select class="csort__select" name="sort" form="catalog-filter" data-catalog-sort>
            <option value="rec">Рекомендуемые</option>
            <option value="stock">В наличии сначала</option>
            <option value="volume-asc">Объём по возрастанию</option>
            <option value="volume-desc">Объём по убыванию</option>
            <option value="name">По названию</option>
          </select>
        </label>
        <fieldset class="cview">
          <legend class="visually-hidden">Вид списка</legend>
          <label class="cview__item">
            <input class="cview__input" type="radio" name="view" value="grid" form="catalog-filter" checked />
            <span class="cview__label">Сетка</span>
          </label>
          <label class="cview__item">
            <input class="cview__input" type="radio" name="view" value="list" form="catalog-filter" />
            <span class="cview__label">Список</span>
          </label>
        </fieldset>
      </div>
      <ul class="catalog__list" data-catalog-list data-view="grid">
        {# Карточки выводит скрипт: загружает public/data/catalog.json и добавляет порциями по мере прокрутки #}
      </ul>
      {# Метка конца списка: когда она подходит к краю экрана, добавляется следующая порция #}
      <div class="catalog__sentinel" aria-hidden="true" data-catalog-sentinel></div>
      <p class="catalog__empty" hidden data-catalog-empty>
        По этим параметрам техники нет. Измените условия или сбросьте фильтры.
      </p>
      <p class="catalog__empty" hidden data-catalog-error>Не удалось загрузить каталог. Обновите страницу.</p>
    </div>
  </div>

  {# Текст каталога и ссылки на разделы: список моделей рисует скрипт, поэтому для поиска и для тех, кто листает вниз, остаётся этот блок #}
  <section class="catalog__about" aria-labelledby="catalog-about-title">
    <h2 class="catalog__about-title" id="catalog-about-title">Каталог полуприцепов-цистерн и автоцистерн</h2>
    <div class="catalog__about-text">
      <p>В каталоге завода «Энергомаш» {{ home.catalogTotals.total }} {{ plural(home.catalogTotals.total, "модель", "модели", "моделей") }}, из них {{ home.catalogTotals.inStock }} {{ plural(home.catalogTotals.inStock, "единица", "единицы", "единиц") }} в наличии на складе. Это полуприцепы-цистерны и автоцистерны на шасси КАМАЗ, Урал и других производителей, навесное оборудование под шасси заказчика и вакуумная техника. Цену не показываем в каталоге: она зависит от комплектации, шасси и способа оплаты, поэтому её рассчитывает менеджер по заявке.</p>
      <p>Подбирайте технику по типу и назначению, объёму, числу секций, осям и подвеске. Модели в наличии отгружаем в течение нескольких дней, остальные изготавливаем под заказ. Если подходящей комплектации нет, завод соберёт цистерну <a href="/blog-cisterna-pod-tehzadanie.html">под техническое задание</a>.</p>
    </div>
    <h3 class="catalog__about-sub">Техника по назначению</h3>
    <ul class="catalog__about-links">
      <li><a href="/benzovozy.html">Бензовозы</a></li>
      <li><a href="/neftevozy.html">Нефтевозы</a></li>
      <li><a href="/avtotoplivozapravschiki.html">Автотопливозаправщики</a></li>
      <li><a href="/vodovozy.html">Водовозы</a></li>
      <li><a href="/cisterny-dlya-pitevoy-vody.html">Цистерны для питьевой воды</a></li>
      <li><a href="/vakuumnye-cisterny.html">Вакуумные цистерны</a></li>
      <li><a href="/avtocisterny-dlya-sbora-nefti.html">Автоцистерны для сбора нефти</a></li>
      <li><a href="/kommunalnye-vakuumnye-mashiny.html">Коммунальные вакуумные машины</a></li>
    </ul>
    <h3 class="catalog__about-sub">Как выбрать</h3>
    <ul class="catalog__about-links">
      <li><a href="/guide.html">Как выбрать цистерну: пошаговый подбор</a></li>
      <li><a href="/blog-kak-vybrat-obem-i-sekcii.html">Объём и число секций</a></li>
      <li><a href="/blog-benzovoz-ili-avtocisterna-chto-vybrat.html">Бензовоз или автоцистерна</a></li>
      <li><a href="/leasing.html">Лизинг и субсидия</a></li>
    </ul>
  </section>

  {# Заготовка карточки: скрипт копирует её и подставляет данные модели #}
  <template data-catalog-template>
    <li class="ccard">
      <article class="ccard__inner">
        <a class="ccard__media" href="/product.html" tabindex="-1" aria-hidden="true" data-card-link>
          <span class="drawing ccard__drawing" role="img" data-card-icon></span>
          <span class="ccard__soon" hidden data-card-soon>Фото скоро появится</span>
          <span class="ccard__badge" data-card-badge></span>
          <span class="ccard__code" hidden data-card-code></span>
        </a>
        <div class="ccard__body">
          <div class="ccard__head">
            <p class="ccard__type" data-card-type></p>
            <h2 class="ccard__title">
              <a class="ccard__link" href="/product.html" data-card-link><span data-card-model></span></a>
            </h2>
          </div>
          <div class="ccard__actions">
            <button class="button button--compact ccard__price" type="button" data-modal-open="quote" data-modal-model>Получить КП</button>
            <span class="ccard__arrow" aria-hidden="true">{{ icon("arrow") }}</span>
          </div>
        </div>
      </article>
    </li>
  </template>
</div>

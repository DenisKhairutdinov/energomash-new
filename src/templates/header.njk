{# Шапка (редизайн с нуля, 2026-10-17): плавающая стеклянная лента с отступом от краёв; меню, справа телефон, значки и акцентная кнопка звонка заподлицо с краем ленты. Ссылки Max и VK в home.json, ключ contacts: заменить адресами страниц завода. #}
{% from "icons.njk" import icon %}
<header class="header" data-header>
  <div class="header__bar container">
    <a class="header__logo" href="/" aria-label="Энергомаш, на главную">
      <img src="/src/assets/images/logo.svg" width="176" height="27" alt="Энергомаш" />
    </a>
    {# Звонок на телефоне: номер спрятан в меню, а для B2B это главное действие; от 1280 px номер и кнопка в самой ленте #}
    <a class="header__call" href="{{ home.contacts.phoneHref }}" aria-label="Позвонить: {{ home.contacts.phone }}">
      {{ icon("phone", "header__call-icon") }}
    </a>
    <button
      class="header__burger"
      type="button"
      aria-expanded="false"
      aria-controls="site-menu"
      data-menu-toggle
    >
      <span class="visually-hidden">Меню</span>
      {{ icon("menu", "header__burger-icon") }}
    </button>
    <div class="header__panel" id="site-menu" data-menu-panel>
      {% include "menu.njk" %}
      <div class="header__contacts">
        <a class="header__phone" href="{{ home.contacts.phoneHref }}">{{ home.contacts.phone }}</a>
        <div class="header__tools">
          <button
            class="header__tool"
            type="button"
            aria-expanded="false"
            aria-controls="site-search"
            aria-label="Поиск по каталогу"
            data-search-toggle
          >
            {{ icon("search", "header__tool-icon") }}
          </button>
          <button class="header__tool" type="button" aria-pressed="false" aria-label="Светлая тема" data-theme-toggle>
            <span class="mask-icon mask-icon--theme" aria-hidden="true"></span>
          </button>
          <a class="header__tool" href="mailto:{{ home.contacts.email }}" aria-label="Написать на почту {{ home.contacts.email }}">
            <span class="mask-icon mask-icon--mail" aria-hidden="true"></span>
          </a>
          <a class="header__tool" href="{{ home.contacts.max }}" target="_blank" rel="noopener noreferrer" aria-label="Мы в Max">
            <span class="mask-icon mask-icon--max" aria-hidden="true"></span>
          </a>
          <a class="header__tool" href="{{ home.contacts.vk }}" target="_blank" rel="noopener noreferrer" aria-label="Мы во ВКонтакте">
            <span class="mask-icon mask-icon--vk" aria-hidden="true"></span>
          </a>
        </div>
        <button class="button button--compact header__cta" type="button" data-modal-open="call">Заказать звонок</button>
      </div>
    </div>
  </div>
  <form class="header__search container" id="site-search" action="/catalog.html" method="get" role="search" data-search>
    <div class="header__search-inner">
      <label class="visually-hidden" for="site-search-input">Поиск по каталогу</label>
      {{ icon("search", "header__search-icon") }}
      <input
        class="header__search-input"
        data-search-input
        id="site-search-input"
        type="search"
        name="q"
        placeholder="Модель, назначение, объём"
        autocomplete="off"
        role="combobox"
        aria-expanded="false"
        aria-controls="search-results"
        aria-autocomplete="list"
      />
      <button class="button button--compact" type="submit">Найти</button>
    </div>
    {# Подсказки: до восьми моделей и строка «все результаты» (scripts/modules/search.ts) #}
    <div class="search__results" id="search-results" role="listbox" aria-label="Подсказки поиска" hidden data-search-results></div>
  </form>
</header>

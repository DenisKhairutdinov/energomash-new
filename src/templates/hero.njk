{# Hero: фото с рябью, огромный тонкий h1, кнопки, категории и мини-фильтр с быстрыми подборками. #}
{# Слои фото: .hero__media двигается и приближается при прокрутке, .hero__zoom отвечает за появление (два разных слоя, чтобы анимации не конфликтовали). #}
{% from "icons.njk" import icon %}
{% from "plural.njk" import plural %}
<section class="hero" id="top" aria-labelledby="hero-title" data-hero data-chapter="Главная">
  <div class="hero__media" data-hero-media>
    <div class="hero__zoom" data-hero-zoom>
      <img
        class="hero__bg"
        src="/src/assets/images/color.webp"
        width="3548"
        height="1774"
        alt=""
        fetchpriority="high"
        data-animated-background
      />
    </div>
  </div>
  <div class="hero__shade" aria-hidden="true"></div>
  {# Окно под текстом: курсор над свободной частью фото вызывает рябь (scripts/modules/water-ripples.ts) #}
  <div class="hero__window" aria-hidden="true" data-support-block></div>

  <div class="hero__inner container">
    <h1 class="hero__title" id="hero-title" data-hero-title>
      {% for line in home.hero.title %}
        <span class="hero__line"><span class="hero__line-in" data-hero-line>{{ line | safe }}</span></span>
      {% endfor %}
    </h1>
    <div class="hero__side">
      <div class="hero__actions">
        <a class="button" href="/catalog.html?in-stock=1" data-hero-side>
          Техника в наличии
          <span class="button__badge">{{ home.catalogTotals.inStock }}</span>
        </a>
        <button class="button button--glass" type="button" data-modal-open="call" data-hero-side>Заказать звонок</button>
      </div>
      <p class="hero__lead" data-hero-side>{{ home.hero.lead }}</p>
    </div>
  </div>

  {# Ярлыки Лизинг, Субсидия, Документы, Сервис убраны с первого экрана (2026-10-19): их 7 выборов в точке решения было слишком много; они остаются в меню «Условия» и в секциях ниже #}
  <div class="hero__bottom container">
    <div class="hero__cats">
      <a class="cat glass" href="/catalog.html?type=semitrailer" data-hero-glass>
        <span class="cat__head">
          <span class="cat__title">Полуприцепы-<wbr />цистерны</span>
          <span class="cat__count mono">{{ home.picker.types[0].count }} {{ plural(home.picker.types[0].count, "модель", "модели", "моделей") }}</span>
        </span>
        <span class="drawing drawing--ppc cat__drawing" aria-hidden="true"></span>
        {{ icon("arrow", "cat__arrow") }}
      </a>
      <a class="cat glass" href="/catalog.html?type=chassis" data-hero-glass>
        <span class="cat__head">
          <span class="cat__title">Автоцистерны</span>
          <span class="cat__count mono">{{ home.picker.types[1].count }} {{ plural(home.picker.types[1].count, "модель", "модели", "моделей") }}</span>
        </span>
        <span class="drawing drawing--chassis cat__drawing" aria-hidden="true"></span>
        {{ icon("arrow", "cat__arrow") }}
      </a>
    </div>

    <form class="picker glass glass--strong" action="/catalog.html" method="get" data-picker aria-labelledby="picker-title" data-hero-glass>
      <h2 class="picker__title" id="picker-title">Подбор по параметрам</h2>
      <fieldset class="picker__field picker__field--type">
        <legend class="picker__legend mono">Тип техники</legend>
        <div class="segmented">
          {% for type in home.picker.types %}
            <label class="segmented__item">
              <input
                class="segmented__input"
                type="radio"
                name="type"
                value="{{ type.value }}"
                data-volume-min="{{ type.volume[0] }}"
                data-volume-max="{{ type.volume[1] }}"
                {% if loop.first %}checked{% endif %}
              />
              <span class="segmented__label">{{ type.title }}</span>
            </label>
          {% endfor %}
        </div>
      </fieldset>
      <div class="picker__field picker__field--purpose">
        <span class="picker__legend mono" id="picker-purpose-label">Назначение</span>
        <select class="picker__select" name="purpose" data-picker-purpose>
          <option value="">Любое</option>
          {% for type in home.picker.types %}
            <optgroup label="{{ type.title }}" data-type="{{ type.value }}">
              {% for purpose in home.picker.purposes[type.value] %}
                <option value="{{ purpose.value }}">{{ purpose.title }}</option>
              {% endfor %}
            </optgroup>
          {% endfor %}
        </select>
      </div>
      <fieldset class="picker__field picker__field--volume">
        <legend class="picker__legend mono">Объём, м³</legend>
        <div class="picker__range">
          <input class="picker__input" type="text" inputmode="numeric" name="volume-from" placeholder="{{ home.picker.types[0].volume[0] }}" aria-label="Объём от" data-volume-from />
          <span aria-hidden="true">–</span>
          <input class="picker__input" type="text" inputmode="numeric" name="volume-to" placeholder="{{ home.picker.types[0].volume[1] }}" aria-label="Объём до" data-volume-to />
        </div>
      </fieldset>
      <label class="check picker__stock">
        <input class="check__input" type="checkbox" name="in-stock" value="1" />
        <span class="check__box" aria-hidden="true">{{ icon("check") }}</span>
        <span class="check__text">В наличии</span>
      </label>
      <button class="button picker__submit" type="submit">Подобрать</button>
    </form>
  </div>

</section>

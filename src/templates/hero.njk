{# Hero: крупный заголовок слева, под ним кнопки и описание поверх фотографии. #}
<section class="hero" id="top" aria-labelledby="hero-title" data-hero data-chapter="Главная">
  <div class="hero__media" data-hero-media>
    <div class="hero__zoom" data-hero-zoom>
      <div class="hero__clouds" aria-hidden="true"></div>
      <img
        class="hero__bg"
        src="/src/assets/hero/industrial_tanker_transparent_2k_upscayl_2x_high-fidelity-4x 1.png"
        width="4096"
        height="2048"
        alt=""
        fetchpriority="high"
      />
    </div>
  </div>
  <div class="hero__shade" aria-hidden="true"></div>
  <div class="hero__window" aria-hidden="true" data-support-block></div>

  <div class="hero__inner container">
    <h1 class="hero__title" id="hero-title" data-hero-title>
      {% for line in home.hero.title %}
        <span class="hero__line"><span class="hero__line-in" data-hero-line>{{ line | safe }}</span></span>
      {% endfor %}
    </h1>
    <div class="hero__side">
      <div class="hero__actions">
        <a class="button" href="/catalog.html?in-stock=1" data-hero-side>
          Техника в наличии
          <span class="button__badge">{{ home.catalogTotals.inStock }}</span>
        </a>
        <button class="button button--glass" type="button" data-modal-open="call" data-hero-side>Заказать звонок</button>
      </div>
      <p class="hero__lead" data-hero-side>{{ home.hero.lead }}</p>
    </div>
  </div>
</section>

{# Завод в цифрах: стеклянные карточки со смещением по высоте поверх фото. Данные: home.facts #}
<section class="facts" aria-label="Завод в цифрах" data-chapter="Завод">
  <div class="facts__bg" data-frame>
    <img src="/src/assets/models/IMG_2134.webp" width="2400" height="1600" alt="" loading="lazy" data-parallax="0.08" />
  </div>
  <div class="facts__inner container">
    <dl class="facts__list">
      {% for fact in home.facts %}
        <div class="facts__item glass glass--strong" data-depth="{{ loop.index * 12 }}">
          <dt class="facts__label mono">{{ fact.label }}</dt>
          <dd class="facts__value"><span data-count="{{ fact.value }}">{{ fact.value }}</span><span class="facts__suffix">{{ fact.suffix }}</span></dd>
        </div>
      {% endfor %}
    </dl>
  </div>
</section>

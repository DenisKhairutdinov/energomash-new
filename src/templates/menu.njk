{# currentPage задаётся на странице как «раздел» или «раздел/подраздел». #}
{# Мега-меню как на старом сайте: панель на всю ширину; у каталога подразделы идут группами (заголовок «Все модели» и плитки), --i задаёт очерёдность появления ячеек. #}
{% from "icons.njk" import icon %}
{% set currentPath = (currentPage or "").split("/") %}
<nav class="menu" aria-label="Основное меню">
  <ul class="menu__list">
    {% for item in nav.menu %}
      {% set children = nav.catalog if item.catalog else item.children %}
      <li class="menu__item">
        <a
          class="menu__link{{ ' menu__link--accent' if item.accent }}{{ ' menu__link--active' if item.id == currentPath[0] }}"
          href="{{ item.url }}"
          {% if item.id == currentPage %}aria-current="page"{% endif %}
        >{{ item.title }}</a>
        {% if children %}
          <div class="menu__dropdown">
            <div class="menu__inner container{{ '' if item.catalog else ' menu__inner--plain' }}">
              {% if item.catalog %}
                <div class="menu__groups">
                  {% for group in children %}
                    <div class="menu__group">
                      <a class="menu__group-head menu__cell" style="--i: {{ loop.index0 }}" href="{{ group.url }}{{ item.urlSuffix }}">
                        <span>{{ group.title }}</span>
                        <span class="menu__group-all">Все модели {{ icon("arrow", "menu__arrow") }}</span>
                      </a>
                      <ul class="menu__tiles">
                        {% for leaf in group.children %}
                          <li class="menu__cell" style="--i: {{ loop.index + 1 }}">
                            <a class="menu__tile" href="{{ leaf.url }}{{ item.urlSuffix }}">
                              <span>{{ leaf.title }}</span>{{ icon("arrow", "menu__arrow") }}
                            </a>
                          </li>
                        {% endfor %}
                      </ul>
                    </div>
                  {% endfor %}
                </div>
                <a class="menu__feature" href="/catalog.html?in-stock=1" tabindex="-1" aria-hidden="true">
                  <img src="/src/assets/models/IMG_4530.webp" width="2400" height="1600" alt="" loading="lazy" />
                  <span class="menu__feature-caption">
                    <span class="mono">На складе</span>
                    <span class="menu__feature-title">{{ home.catalogTotals.inStock }} единицы</span>
                  </span>
                </a>
              {% else %}
                <ul class="menu__tiles">
                  {% for child in children %}
                    <li class="menu__cell" style="--i: {{ loop.index0 }}">
                      <a class="menu__tile{{ ' is-current' if child.id == currentPath[1] }}" href="{{ child.url }}{{ item.urlSuffix }}">
                        <span>{{ child.title }}</span>{{ icon("arrow", "menu__arrow") }}
                      </a>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          </div>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</nav>

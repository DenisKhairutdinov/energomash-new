{# Подвал: огромное слово завода и чертёж цистерны; под ним реквизиты и ссылки. #}
<footer class="footer theme-dark" data-footer>
  <div class="footer__mega" aria-hidden="true">
    <span class="footer__word" data-footer-word>Энергомаш</span>
    <span class="drawing drawing--chassis footer__drawing"></span>
  </div>
  <div class="footer__grid container">
    <div class="footer__brand">
      <a class="footer__logo" href="/" aria-label="Энергомаш, на главную">
        <img src="/src/assets/images/logo.svg" width="176" height="27" alt="Энергомаш" loading="lazy" />
      </a>
      <p class="footer__lead">Завод-производитель полуприцепов-цистерн и автоцистерн</p>
      <a class="footer__phone" href="{{ home.contacts.phoneHref }}">{{ home.contacts.phone }}</a>
      <a class="footer__mail link-arrow" href="mailto:{{ home.contacts.email }}">{{ home.contacts.email }}</a>
    </div>
    <nav class="footer__col" aria-label="Навигация в подвале">
      <h2 class="footer__title mono">Разделы</h2>
      <ul class="footer__list">
        <li><a class="link-arrow" href="/catalog.html">Каталог</a></li>
        <li><a class="link-arrow" href="/catalog.html?in-stock=1">В наличии</a></li>
        <li><a class="link-arrow" href="/terms.html">Условия</a></li>
        <li><a class="link-arrow" href="/about.html">О заводе</a></li>
        <li><a class="link-arrow" href="/blog.html">Блог</a></li>
        <li><a class="link-arrow" href="/contacts.html">Контакты</a></li>
      </ul>
    </nav>
    <div class="footer__col">
      <h2 class="footer__title mono">Адреса</h2>
      <dl class="footer__details">
        {% for office in home.offices %}
          <div>
            <dt class="mono">{{ office.title }}</dt>
            <dd>{{ office.text }}</dd>
          </div>
        {% endfor %}
      </dl>
    </div>
    <div class="footer__col">
      <h2 class="footer__title mono">Реквизиты</h2>
      <dl class="footer__details">
        {% for item in home.requisites %}
          <div>
            <dt class="mono">{{ item.title }}</dt>
            <dd>{{ item.text }}</dd>
          </div>
        {% endfor %}
      </dl>
      <a class="footer__more link-arrow" href="/company-details.html">Все реквизиты</a>
    </div>
  </div>
  <div class="footer__legal container">
    <p>© 2026 ООО «Энергомаш». Все права защищены</p>
    <ul>
      {% for link in nav.legal %}
        <li><a class="link-arrow" href="{{ link.url }}">{{ link.title }}</a></li>
      {% endfor %}
    </ul>
  </div>
</footer>

{# Блог: заголовок и подпись над сеткой, затем свежая статья и плитка «Все статьи», ниже видео. #}
{% from "icons.njk" import icon %}
{# Композиция карточки: сверху дата крупно акцентом и стрелка, снизу рубрика маленькой подписью и заголовок #}
{% macro date(post) %}
  {% set parts = post.dateShort.split(' ') %}
  <time class="news__date" datetime="{{ post.datetime }}"><span class="news__day">{{ parts[0] }}</span><span class="news__month">{{ parts[1] }}</span></time>
{% endmacro %}
<section class="blog" aria-labelledby="blog-title" data-chapter="Блог">
  <div class="blog__head">
    <h2 class="section-title blog__title" id="blog-title" data-split>Блог</h2>
    <p class="blog__lead">Статьи завода о цистернах, сервисе и эксплуатации техники.</p>
  </div>
  <div class="blog__grid">
    {% for post in blog.posts | sort(true, false, "datetime") %}
      {% if loop.first %}
        <a class="news news--lead" href="{{ post.url }}">
          {{ date(post) }}
          {{ icon("arrow", "news__arrow") }}
          <span class="news__bottom">
            <span class="news__rubric">{{ post.rubric }}</span>
            <span class="news__title">{{ post.title }}</span>
            <span class="news__excerpt">{{ post.excerpt }}</span>
          </span>
        </a>
      {% endif %}
    {% endfor %}
    <a class="news blog__all" href="/blog.html">
      {{ icon("arrow", "news__arrow") }}
      <span class="news__bottom">
        <span class="news__title">Все статьи</span>
      </span>
    </a>
    {# Нижний ряд: видео-ролики одной композиции (рубрика и длительность, заголовок, о чём ролик, кнопка воспроизведения). Плеер: scripts/modules/blog-video.ts #}
    <div class="blog__row">
      {% for video in blogVideos %}
        {% set crop = '197 498 428 154' %}
        {% if video.id == 'tank-blender' %}{% set crop = '642 498 428 154' %}{% endif %}
        {% if video.id == 'oil-braking' %}{% set crop = '1085 498 432 154' %}{% endif %}
        <button class="news news--video news--brand-cover" type="button" data-blog-video="{{ video.id }}" data-blog-video-title="{{ video.title }}" aria-label="Смотреть видео: {{ video.title }} · {{ video.duration }}" aria-haspopup="dialog">
          <svg class="news__cover" viewBox="{{ crop }}" aria-hidden="true" focusable="false"><image href="/src/assets/videos/brand-covers-board.png" width="1536" height="1024"/></svg>
        </button>
      {% endfor %}
    </div>
  </div>
  <dialog class="video-dialog" aria-label="Просмотр видео" data-video-dialog data-lenis-prevent>
    <button class="video-dialog__close" type="button" aria-label="Закрыть" data-video-close>×</button>
    <video class="video-dialog__player" controls playsinline preload="none" data-video-player></video>
    <p class="video-dialog__caption" data-video-caption></p>
  </dialog>
</section>

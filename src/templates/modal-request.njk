{% from "icons.njk" import icon %}
<dialog class="modal theme-dark" aria-labelledby="request-modal-title" data-modal data-lenis-prevent>
  <div class="modal__panel">
    <button class="modal__close" type="button" aria-label="Закрыть окно" data-modal-close>
      {{ icon("close") }}
    </button>
    <div class="modal__aside">
      <h2 class="modal__title" id="request-modal-title" data-modal-title>Заказать звонок</h2>
      <p class="modal__text" data-modal-text>
        Оставьте телефон. Менеджер перезвонит в рабочее время, уточнит задачу и подскажет подходящую модель.
      </p>
      <p class="modal__model" hidden data-modal-model-row>
        Модель: <strong data-modal-model></strong>
      </p>
      <a class="modal__phone" href="{{ home.contacts.phoneHref }}">{{ home.contacts.phone }}</a>
    </div>
    <form class="modal__form" action="#" method="post" novalidate data-request-form>
      <input type="hidden" name="kind" value="call" />
      <input type="hidden" name="model" value="" />
      <label class="field">
        <span class="field__label">Имя</span>
        <input class="field__control" type="text" name="name" autocomplete="name" />
      </label>
      <label class="field">
        <span class="field__label">Телефон <span aria-hidden="true">*</span></span>
        <input
          class="field__control"
          type="tel"
          name="phone"
          inputmode="tel"
          autocomplete="tel"
          placeholder="+7 (___) ___-__-__"
          required
          aria-describedby="modal-phone-error"
        />
        <span class="field__error" id="modal-phone-error" hidden data-error="phone">Укажите телефон, чтобы мы могли перезвонить</span>
      </label>
      <label class="field">
        <span class="field__label">Комментарий</span>
        <textarea class="field__control field__control--area" name="comment" rows="3"></textarea>
      </label>
      <label class="check">
        <input class="check__input" type="checkbox" name="consent" required />
        <span class="check__box" aria-hidden="true">{{ icon("check") }}</span>
        <span class="check__text">Согласен на <a href="/privacy.html" target="_blank" rel="noopener">обработку персональных данных</a></span>
      </label>
      <span class="field__error" hidden data-error="consent">Нужно согласие на обработку данных</span>
      <button class="button button--accent" type="submit">Отправить заявку</button>
      <p class="modal__done" hidden data-form-done role="status">Заявка отправлена. Мы свяжемся с вами в ближайшее рабочее время.</p>
    </form>
  </div>
</dialog>

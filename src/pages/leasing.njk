{% extends "layout.njk" %}
{% set pagePath = "/leasing.html" %}
{% set pageTitle = "Лизинг цистерн и спецтехники" %}
{% set pageDescription = "Лизинг цистерн «Энергомаш»: калькулятор платежа, партнёры, субсидия 10% стоимости до 500 000 ₽. Преимущества лизинга перед кредитом и порядок оформления." %}
{% set currentPage = "terms/leasing" %}
{% set pageClass = "inner" %}
{% block content %}
{% from "ip.njk" import head, sec, cta, crumbs, faq %}
<article class="ip">
  {{ crumbs([["Условия", "/terms.html"], ["Лизинг", "/leasing.html"]]) }}
  {{ head("Лизинг", "Лизинг помогает купить спецтехнику без залога и снизить налог на прибыль. Посчитайте платёж в калькуляторе и выберите лизинговую компанию.", '<a href="/terms.html">Условия</a>', false, "IMG_4613.webp", "dark") }}

  {% include "leasing.njk" %}

  {% call sec("Преимущества лизинга", "leasing-pros", "Чем лизинг выгоднее кредита при покупке цистерны.", true) %}
    <ul class="ip__tiles ip__tiles--2">
      <li class="ip__tile"><h3 class="ip__tile-title">Без залога</h3><p class="ip__tile-text">Транспортное средство принадлежит лизинговой компании до последнего платежа, поэтому залог не требуется.</p></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Налог на прибыль</h3><p class="ip__tile-text">Платежи по лизинговому договору относятся к себестоимости и снижают налог на прибыль.</p></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Быстрая амортизация</h3><p class="ip__tile-text">Ускоренная амортизация уменьшает налоговую базу. Детали уточните у бухгалтера.</p></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Субсидия</h3><p class="ip__tile-text">При покупке в лизинг можно получить компенсацию 10% стоимости техники, до 500 000 ₽ на единицу.</p></li>
    </ul>
  {% endcall %}

  {% call sec("Как оформить", "leasing-steps", "Завод работает со всеми лизинговыми компаниями.") %}
    <ol class="ip__tiles ip__tiles--3">
      <li class="ip__tile"><span class="ip__tile-num" aria-hidden="true">1</span><h3 class="ip__tile-title">Выберите технику</h3><p class="ip__tile-text">Модель из каталога или наличия и комплектация. Менеджер поможет сверить параметры с вашей перевозкой.</p></li>
      <li class="ip__tile"><span class="ip__tile-num" aria-hidden="true">2</span><h3 class="ip__tile-title">Выберите лизингодателя</h3><p class="ip__tile-text">Сравните условия в калькуляторе. Точные цифры подтверждает лизинговая компания.</p></li>
      <li class="ip__tile"><span class="ip__tile-num" aria-hidden="true">3</span><h3 class="ip__tile-title">Подайте заявку</h3><p class="ip__tile-text">Подготовьте документы компании. Завод предоставит коммерческое предложение и данные о технике.</p></li>
      <li class="ip__tile"><span class="ip__tile-num" aria-hidden="true">4</span><h3 class="ip__tile-title">Подпишите договоры</h3><p class="ip__tile-text">Купли-продажи с заводом и лизинга с лизинговой компанией.</p></li>
      <li class="ip__tile"><span class="ip__tile-num" aria-hidden="true">5</span><h3 class="ip__tile-title">Получите технику</h3><p class="ip__tile-text">Передаём технику с паспортом, ОТТС, сертификатами и гарантийным талоном.</p></li>
    </ol>
    <div class="prose">
      <p>По вопросам лизинга позвоните по телефону <a href="tel:88001012200">8 800 101 22 00</a> или напишите на <a href="mailto:lizing@bik55.ru">lizing@bik55.ru</a>.</p>
      <p>Сравнение лизинга с кредитом и покупкой за свои: <a href="/blog-lizing-kredit-ili-pokupka.html">«Лизинг, кредит или прямая покупка»</a>. Про субсидию: <a href="/blog-subsidiya-poshagovo.html">как оформить технику по субсидии</a>.</p>
    </div>
  {% endcall %}

  {% call sec("Что учесть при выборе условий", "leasing-terms", "Пять параметров, которые меняют итоговую переплату.", true) %}
    <ul class="ip__tiles ip__tiles--3">
      <li class="ip__tile"><h3 class="ip__tile-title">Аванс</h3><p class="ip__tile-text">Чем выше аванс, тем ниже ежемесячный платёж и общая переплата.</p></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Срок</h3><p class="ip__tile-text">Длинный срок уменьшает платёж, но увеличивает итоговую стоимость.</p></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Удорожание</h3><p class="ip__tile-text">Сравнивайте не платёж, а то, насколько итоговая сумма больше цены техники.</p></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Выкупная стоимость</h3><p class="ip__tile-text">В одних программах она символическая, в других составляет заметную долю.</p></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Страхование</h3><p class="ip__tile-text">Лизингодатель обычно требует страховать технику, это добавляет расходы.</p></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Субсидия</h3><p class="ip__tile-text">Уменьшает финансируемую сумму: <a href="/subsidies.html">условия и пример</a>.</p></li>
    </ul>
    <div class="prose"><p>Как сравнить предложения и посчитать переплату на примере: <a href="/blog-lizing-cisterny-dokumenty-i-raschet.html">«Лизинг цистерны: документы, аванс и расчёт переплаты»</a>. Как оценить окупаемость техники: <a href="/blog-okupaemost-cisterny.html">«Окупаемость цистерны»</a>.</p></div>
  {% endcall %}

  {% call sec("Вопросы", "leasing-faq", "Частые вопросы о лизинге.") %}
    {{ faq([
      ["Какие документы нужны для лизинга?", "Заявка, учредительные документы, отчётность и сведения об обязательствах. Точный перечень зависит от лизинговой компании и суммы сделки, менеджер подскажет."],
      ["На кого регистрируется техника?", "Как правило, на лизингодателя, а вы получаете её во владение и пользование. Порядок указан в договоре."],
      ["Можно ли получить субсидию при лизинге?", "Да, при покупке в лизинг действует компенсация 10% стоимости, до 500 000 ₽ на единицу: <a href='/subsidies.html'>условия субсидии</a>."],
      ["Кто готовит документы на технику для лизинговой компании?", "Завод передаёт коммерческое предложение, спецификацию и документы на технику и помогает собрать пакет для одобрения."]
    ], "leasing-faq") }}
  {% endcall %}

  {{ cta("Рассчитаем<br />лизинг под вас", "Оставьте заявку, и менеджер подберёт технику, партнёра и график платежей.", "Получить расчёт") }}
</article>
{% endblock %}

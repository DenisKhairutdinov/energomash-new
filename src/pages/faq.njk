{% extends "layout.njk" %}
{% set pagePath = "/faq.html" %}
{% set pageTitle = "Вопросы и ответы о цистернах Энергомаш" %}
{% set pageDescription = "Ответы на частые вопросы о покупке цистерн «Энергомаш»: сроки, лизинг и субсидия, комплектация, документы и допуск ДОПОГ, гарантия, сервис, доставка." %}
{% set currentPage = "about/faq" %}
{% set pageClass = "inner" %}
{% block content %}
{% from "ip.njk" import head, sec, cta, crumbs, faq %}
<article class="ip">
  {{ crumbs([["О заводе", "/about.html"], ["Вопросы и ответы", "/faq.html"]]) }}
  {{ head("Вопросы и ответы", "Сроки, лизинг и субсидия, комплектация, документы, гарантия и доставка. Если ответа нет, позвоните: 8 (800) 101-22-00.", '<a href="/about.html">О заводе</a>', false, "IMG_4974.webp", "plain") }}

  {% call sec("Покупка и сроки", "faq-buy", "Как проходит заказ и сколько он занимает.") %}
    {{ faq([
      ["Сколько времени занимает изготовление?", "Техника в наличии отгружается в течение нескольких дней. Изготовление под заказ занимает от четырёх недель в зависимости от комплектации."],
      ["Как получить коммерческое предложение?", "Оставьте заявку на сайте или позвоните. Менеджер уточнит задачу, подберёт модель и пришлёт предложение с ценой и сроками."],
      ["Как узнать, какая техника есть в наличии?", "Откройте раздел «В наличии» в каталоге. Остатки на складе показаны у каждой модели."],
      ["Можно ли приехать на завод?", "Да, покупатель может приехать на приёмку и проверить технику лично. Согласуйте время с менеджером."],
      ["Можно ли заказать несколько единиц сразу?", "Да. Для партий менеджер подготовит отдельное предложение и график поставки."],
      ["Где находится производство?", "В Челябинской области, Мисяш, 5 км автодороги Чебаркуль–Архангельское. Офисы находятся в Челябинске и Набережных Челнах."]
    ], "faq-buy") }}
  {% endcall %}

  {% call sec("Оплата и лизинг", "faq-pay", "Способы оплаты, лизинг и субсидия.", true) %}
    {{ faq([
      ["Можно ли купить технику в лизинг?", "Да, завод работает со всеми лизинговыми компаниями и помогает подготовить пакет документов для одобрения."],
      ["Что выгоднее: лизинг, кредит или оплата сразу?", "Зависит от налогов, оборотных средств и сроков. Сравнение в статье «Лизинг, кредит или прямая покупка»."],
      ["Что такое субсидия при лизинге?", "Государство компенсирует 10% стоимости техники, но не более 500 000 ₽ на единицу. Действует только при лизинге."],
      ["Как посчитать платёж?", "Воспользуйтесь калькулятором лизинга на сайте. Точные цифры подтверждает лизинговая компания."],
      ["Какие реквизиты у завода?", "Реквизиты для договора и платёжных поручений в разделе «Реквизиты»."]
    ], "faq-pay") }}
  {% endcall %}

  {% call sec("Техника и комплектация", "faq-tech", "Параметры, опции и доработки.") %}
    {{ faq([
      ["Можно ли изменить комплектацию под задачу?", "Да: объём и число секций, насосное и сливное оборудование, подвеска, тип шасси, термоизоляция. Подберём вариант под вашу перевозку."],
      ["Чем отличается полуприцеп-цистерна от автоцистерны?", "Полуприцеп работает с седельным тягачом и перевозит большие объёмы. Автоцистерна смонтирована на шасси и несёт насосное оборудование."],
      ["Какая подвеска лучше: рессорная или пневматическая?", "Рессорная проще и выдерживает тяжёлые дороги, пневматическая мягче и бережёт шины и груз. Сравнение в статье о подвесках."],
      ["Нужна ли термоизоляция?", "Для вязких продуктов и холодного климата да. Для воды и светлых нефтепродуктов изоляция нужна не всегда."],
      ["Как проверить совместимость с тягачом?", "Сверьте высоту ССУ полуприцепа с высотой седла тягача. Подробнее в статье «Как выбрать ССУ»."],
      ["Можно ли смонтировать оборудование на моё шасси?", "Да, в каталоге есть комплекты навесного оборудования. Условия монтажа уточните у менеджера."]
    ], "faq-tech") }}
  {% endcall %}

  {% call sec("Документы и допуск", "faq-docs", "Регистрация, ДОПОГ и учёт.", true) %}
    {{ faq([
      ["Какие документы выдаются вместе с техникой?", "ОТТС, сертификаты соответствия, паспорт и гарантийный талон. Помогаем с регистрацией и допуском на перевозку опасных грузов."],
      ["Что нужно для перевозки нефтепродуктов?", "Допуск транспортного средства по ДОПОГ, маркировка, документы и подготовленный водитель. Подробнее в статье «ДОПОГ и регламенты»."],
      ["Можно ли использовать цистерну для учёта объёма?", "Да, для моделей, прошедших утверждение типа и поверку. Проверяйте записи в ГРСИ и «Аршин»."],
      ["Как оформить заземление при наливе?", "Заземляйте цистерну до подключения рукавов и снимайте после отключения. Порядок описан в статье о заземлении."]
    ], "faq-docs") }}
  {% endcall %}

  {% call sec("Гарантия, сервис и доставка", "faq-service", "После покупки.") %}
    {{ faq([
      ["Какая гарантия на технику?", "12 месяцев со дня продажи или 30 000 км пробега, что наступит раньше, при соблюдении правил эксплуатации."],
      ["Кто отвечает за шасси?", "Гарантию на шасси даёт его производитель: ПАО «КАМАЗ» или АЗ «Урал»."],
      ["Что не входит в гарантию?", "Расходные материалы, детали с естественным износом и неисправности из-за нарушения правил эксплуатации."],
      ["Как доставляется техника?", "Полуприцепы доезжают своим ходом с тягачом заказчика, автоцистерны отправляем по согласованному маршруту. Доставка выполняется как дополнительная услуга проверенными транспортными компаниями."],
      ["Есть ли запчасти на складе?", "Да, склад запчастей сокращает простои техники. Обратитесь к сервисной службе."]
    ], "faq-service") }}
  {% endcall %}

  {{ cta("Не нашли<br />ответ", "Задайте вопрос менеджеру. Ответим и подберём техническое решение.", "Задать вопрос") }}
</article>
{% endblock %}

{% extends "layout.njk" %}
{% set pagePath = "/docs.html" %}
{% set pageTitle = "Сертификаты и документы на цистерны" %}
{% set pageDescription = "Документы на технику «Энергомаш»: ОТТС и электронный ПТС, соответствие ТР ТС 018/2011 и 032/2013, допуск ДОПОГ категории FL, ГРСИ и «Аршин». Что передаём заказчику." %}
{% set currentPage = "about/docs" %}
{% set pageClass = "inner" %}
{% block content %}
{% from "ip.njk" import head, sec, cta, crumbs, faq %}
<article class="ip">
  {{ crumbs([["О заводе", "/about.html"], ["Сертификаты и документы", "/docs.html"]]) }}
  {{ head("Сертификаты и документы", "Техника выходит с завода с полным пакетом документов для регистрации и перевозки. Помогаем с допуском и подтверждением параметров.", '<a href="/about.html">О заводе</a>', false, "IMG_4623_1.webp", "plain") }}

  {% call sec("Что передаём с техникой", "docs-pack", "Пакет документов для постановки на учёт и эксплуатации.") %}
    <ul class="ip__tiles ip__tiles--2">
      {% for doc in home.docs %}
        <li class="ip__tile"><h3 class="ip__tile-title">{{ doc.title }}</h3><p class="ip__tile-text">{{ doc.text }}</p></li>
      {% endfor %}
    </ul>
  {% endcall %}

  {% call sec("Передаваемые документы", "docs-list", "Комплект при передаче техники.", true) %}
    <ul class="ip__tiles ip__tiles--2">
      <li class="ip__tile"><h3 class="ip__tile-title">Паспорт</h3><p class="ip__tile-text">Основные параметры и комплектация конкретной единицы техники.</p></li>
      <li class="ip__tile"><h3 class="ip__tile-title">ОТТС</h3><p class="ip__tile-text">Одобрение типа транспортного средства для регистрации. Подробнее ниже.</p></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Сертификаты соответствия</h3><p class="ip__tile-text">Подтверждают соответствие технике регламентам.</p></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Гарантийный талон и сервисная книжка</h3><p class="ip__tile-text">Условия гарантии, график обслуживания, отметки о ТО.</p></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Руководство по эксплуатации</h3><p class="ip__tile-text">Правила работы с оборудованием и обслуживания.</p></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Документы по измерениям</h3><p class="ip__tile-text">Для моделей, которые применяют в коммерческом учёте: данные ГРСИ и поверки.</p></li>
    </ul>
  {% endcall %}

  {% call sec("Что означают документы", "docs-explain", "Короткие пояснения для покупателя.") %}
    <div class="prose">
      <h3>ОТТС и электронный ПТС</h3>
      <p>Одобрение типа транспортного средства подтверждает, что конструкция соответствует требованиям безопасности. На его основе оформляется электронный паспорт транспортного средства и проводится регистрация.</p>
      <h3>ТР ТС 018/2011 и 032/2013</h3>
      <p>Технический регламент Таможенного союза о безопасности колёсных транспортных средств и регламент о безопасности оборудования, работающего под избыточным давлением.</p>
      <h3>ДОПОГ, категория FL</h3>
      <p>Допуск транспортного средства к перевозке опасных грузов, в том числе нефтепродуктов. Подробнее: <a href="/blog-dopog-i-reglamenty.html">«ДОПОГ и регламенты»</a> и <a href="/options.html">оборудование ДОПОГ</a>.</p>
      <h3>ГРСИ и «Аршин»</h3>
      <p>Реестр средств измерений и информационная система поверок. Нужны, если цистерна используется для измерения объёма при расчётах: <a href="/blog-grsi-i-arshin.html">как проверить</a>.</p>
    </div>
  {% endcall %}

  {% call sec("Как проверить документы при получении", "docs-check", "Пять проверок перед подписанием акта.") %}
    <ol class="ip__tiles ip__tiles--3">
      <li class="ip__tile"><span class="ip__tile-num" aria-hidden="true">1</span><h3 class="ip__tile-title">Идентификационный номер</h3><p class="ip__tile-text">Номер в паспорте совпадает с номером на раме и на табличке изготовителя.</p></li>
      <li class="ip__tile"><span class="ip__tile-num" aria-hidden="true">2</span><h3 class="ip__tile-title">Тип и массы</h3><p class="ip__tile-text">Тип транспортного средства, разрешённая масса и нагрузки на оси указаны верно.</p></li>
      <li class="ip__tile"><span class="ip__tile-num" aria-hidden="true">3</span><h3 class="ip__tile-title">Собственник</h3><p class="ip__tile-text">В паспорте указана ваша организация или лизинговая компания.</p></li>
      <li class="ip__tile"><span class="ip__tile-num" aria-hidden="true">4</span><h3 class="ip__tile-title">Комплект</h3><p class="ip__tile-text">Есть гарантийный талон, сервисная книжка и руководство по эксплуатации.</p></li>
      <li class="ip__tile"><span class="ip__tile-num" aria-hidden="true">5</span><h3 class="ip__tile-title">Допуск</h3><p class="ip__tile-text">Если груз опасный, оформлен допуск по ДОПОГ: <a href="/blog-dopog-i-reglamenty.html">как это работает</a>.</p></li>
    </ol>
    <div class="prose"><p>Подробнее об ОТТС и электронном паспорте: <a href="/blog-ottc-i-elektronnyy-ptc-na-cisternu.html">«ОТТС и электронный ПТС на цистерну»</a>, о приёмке на заводе: <a href="/blog-priemka-tehniki-na-zavode.html">«Приёмка техники»</a>.</p></div>
  {% endcall %}

  {% call sec("Вопросы", "docs-faq", "Частые вопросы о документах.", true) %}
    {{ faq([
      ["Помогаете ли с регистрацией?", "Да, помогаем с регистрацией и допуском на перевозку опасных грузов."],
      ["Когда выдаются документы?", "Вместе с техникой при передаче. Копии для лизинговой компании готовим на этапе оформления."],
      ["Можно ли получить сертификаты заранее?", "Да, предоставим копии для тендера или согласования. Запросите их у менеджера."],
      ["Чем ОТТС отличается от электронного паспорта?", "ОТТС выдаётся на тип техники, электронный паспорт оформляется на конкретную машину по идентификационному номеру."],
      ["Нужны ли документы по ГРСИ на каждую цистерну?", "Они нужны для моделей, которые применяют в коммерческом учёте: когда объём измеряется при расчётах. Подробнее: <a href='/blog-grsi-i-arshin.html'>ГРСИ и Аршин</a>."]
    ], "docs-faq") }}
  {% endcall %}

  {{ cta("Нужны<br />документы", "Запросите копии сертификатов или консультацию по допуску.", "Запросить документы") }}
</article>
{% endblock %}

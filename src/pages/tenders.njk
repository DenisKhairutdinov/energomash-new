{% extends "layout.njk" %}
{% set pagePath = "/tenders.html" %}
{% set pageTitle = "Тендеры и закупки цистерн" %}
{% set pageDescription = "Участие в тендерах и закупках техники «Энергомаш»: какие документы и характеристики готовим для заявки, как запросить коммерческое предложение и технические данные." %}
{% set currentPage = "terms/tenders" %}
{% set pageClass = "inner" %}
{% block content %}
{% from "ip.njk" import head, sec, cta, crumbs, faq %}
<article class="ip">
  {{ crumbs([["Условия", "/terms.html"], ["Тендеры", "/tenders.html"]]) }}
  {{ head("Тендеры", "Поможем подготовить заявку для закупки цистерн: технические характеристики, коммерческое предложение и документы на технику.", '<a href="/terms.html">Условия</a>', false, "IMG_2119.webp", "plain") }}

  {% call sec("Что готовим для закупки", "tenders-what", "Пакет документов под требования заказчика.") %}
    <ul class="ip__tiles ip__tiles--2">
      <li class="ip__tile"><h3 class="ip__tile-title">Технические характеристики</h3><p class="ip__tile-text">Объём, секции, оси, подвеска, оборудование, шасси. Параметры согласуем с техническим заданием закупки.</p></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Коммерческое предложение</h3><p class="ip__tile-text">Цена, комплектация, сроки изготовления и поставки, условия гарантии.</p></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Документы на технику</h3><p class="ip__tile-text">ОТТС, сертификаты соответствия, данные ДОПОГ, ГРСИ для моделей, которые к этому предназначены.</p></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Документы компании</h3><p class="ip__tile-text">Реквизиты и карточка предприятия. Скачать карточку можно в разделе <a href="/company-details.html">«Реквизиты»</a>.</p></li>
    </ul>
  {% endcall %}

  {% call sec("Как работаем", "tenders-steps", "От запроса до подачи заявки.", true) %}
    <ol class="ip__tiles ip__tiles--4">
      <li class="ip__tile"><span class="ip__tile-num" aria-hidden="true">1</span><h3 class="ip__tile-title">Запрос</h3><p class="ip__tile-text">Пришлите техническое задание или ссылку на закупку.</p></li>
      <li class="ip__tile"><span class="ip__tile-num" aria-hidden="true">2</span><h3 class="ip__tile-title">Подбор</h3><p class="ip__tile-text">Подберём модель и комплектацию под требования.</p></li>
      <li class="ip__tile"><span class="ip__tile-num" aria-hidden="true">3</span><h3 class="ip__tile-title">Предложение</h3><p class="ip__tile-text">Подготовим коммерческое предложение и документы.</p></li>
      <li class="ip__tile"><span class="ip__tile-num" aria-hidden="true">4</span><h3 class="ip__tile-title">Сопровождение</h3><p class="ip__tile-text">Ответим на вопросы заказчика закупки и подтвердим параметры.</p></li>
    </ol>
    <div class="prose"><p>Как составить техническое задание на цистерну: <a href="/blog-cisterna-pod-tehzadanie.html">что можно менять в конфигурации</a>. Про допуск и документы на перевозку нефтепродуктов: <a href="/blog-dopog-i-reglamenty.html">ДОПОГ и регламенты</a>.</p></div>
  {% endcall %}

  {% call sec("Типичные требования закупок", "tenders-requirements", "Что обычно проверяет заказчик и чем это подтверждается.") %}
    <ul class="ip__tiles ip__tiles--2">
      <li class="ip__tile"><h3 class="ip__tile-title">Соответствие регламентам</h3><p class="ip__tile-text">Соответствие ТР ТС 018/2011 и 032/2013 подтверждает ОТТС и сертификаты соответствия.</p></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Допуск для опасных грузов</h3><p class="ip__tile-text">Допуск по ДОПОГ, категория FL: оборудование и документы для перевозки нефтепродуктов.</p></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Измерения</h3><p class="ip__tile-text">Для моделей, которые применяют в учёте, данные ГРСИ и сведения о поверке в системе «Аршин».</p></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Гарантия и сервис</h3><p class="ip__tile-text">Гарантия 12 месяцев или 30 000 км, сервисная книжка, склад запчастей.</p></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Сроки поставки</h3><p class="ip__tile-text">Из наличия за несколько дней, под заказ от четырёх недель.</p></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Эквивалентность</h3><p class="ip__tile-text">Если в задании указаны конкретные параметры, подберём модель и подтвердим соответствие характеристик.</p></li>
    </ul>
    <div class="prose"><p>Документы подробно описаны на странице <a href="/docs.html">«Сертификаты и документы»</a>, а гарантия — на странице <a href="/services.html">«Сервис и запчасти»</a>.</p></div>
  {% endcall %}

  {% call sec("Как подготовить запрос", "tenders-brief", "Что указать, чтобы предложение пришло быстрее.", true) %}
    <ol class="ip__tiles ip__tiles--3">
      <li class="ip__tile"><span class="ip__tile-num" aria-hidden="true">1</span><h3 class="ip__tile-title">Задание или ссылка</h3><p class="ip__tile-text">Приложите техническое задание или ссылку на закупку с требованиями.</p></li>
      <li class="ip__tile"><span class="ip__tile-num" aria-hidden="true">2</span><h3 class="ip__tile-title">Продукт и условия</h3><p class="ip__tile-text">Укажите, что будете возить, и климат района работы.</p></li>
      <li class="ip__tile"><span class="ip__tile-num" aria-hidden="true">3</span><h3 class="ip__tile-title">Сроки и контакты</h3><p class="ip__tile-text">Срок подачи заявки, регион поставки и контакт ответственного.</p></li>
    </ol>
  {% endcall %}

  {% call sec("Вопросы", "tenders-faq", "Что чаще всего спрашивают участники закупок.") %}
    {{ faq([
      ["Можно ли получить предложение под конкретное техническое задание?", "Да, отправьте задание, и мы подготовим предложение с учётом заказных параметров."],
      ["Какие документы подтверждают соответствие техники?", "ОТТС, сертификаты соответствия, паспорт и документы ДОПОГ. Для моделей, применяемых в коммерческом учёте, предоставляем данные ГРСИ."],
      ["Какие сроки поставки указывать?", "Для техники из наличия отгрузка за несколько дней, для заказной от четырёх недель. Точные сроки назовёт менеджер."],
      ["Можно ли получить копии сертификатов до подачи заявки?", "Да, предоставим копии для согласования. Запросите их у менеджера."],
      ["Что делать, если в задании требуется нестандартная комплектация?", "Расскажите о требованиях: завод изготавливает технику по техническому заданию. Что можно менять, описано в статье <a href='/blog-cisterna-pod-tehzadanie.html'>«Цистерна под техническое задание»</a>."]
    ], "tenders-faq") }}
  {% endcall %}

  {{ cta("Нужно<br />предложение", "Отправьте техническое задание, и мы подготовим коммерческое предложение и документы.", "Запросить предложение") }}
</article>
{% endblock %}

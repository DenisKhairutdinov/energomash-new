{% extends "layout.njk" %}
{% set pagePath = "/services.html" %}
{% set pageTitle = "Гарантия, сервис и запчасти для цистерн" %}
{% set pageDescription = "Гарантия завода «Энергомаш» на технику: 12 месяцев или 30 000 км. Что покрывает гарантия, как обслуживать цистерну, запчасти и поддержка сервисной службы." %}
{% set currentPage = "about/services" %}
{% set pageClass = "inner" %}
{% block content %}
{% from "ip.njk" import head, sec, cta, crumbs, faq, band %}
<article class="ip">
  {{ crumbs([["О заводе", "/about.html"], ["Сервис и запчасти", "/services.html"]]) }}
  {{ head("Сервис и запчасти", "Гарантия 12 месяцев или 30 000 км, обслуживание и запчасти. Завод поддерживает технику на всех этапах эксплуатации.", '<a href="/about.html">О заводе</a>', false, "IMG_2499.webp", "split-r") }}

  {% call sec("Гарантия", "svc-warranty", "Что гарантирует завод «Энергомаш».") %}
    <ul class="ip__facts">
      <li class="ip__fact"><span class="ip__fact-value">12 мес.</span><span class="ip__fact-label">со дня продажи</span></li>
      <li class="ip__fact"><span class="ip__fact-value">30 000 км</span><span class="ip__fact-label">пробега, что наступит раньше</span></li>
    </ul>
    <div class="prose">
      <p>Завод «Энергомаш» гарантирует исправную работу спецтехники в течение 12 месяцев со дня продажи или до пробега 30 000 км, в зависимости от того, что наступит ранее. Условие: соблюдение правил по эксплуатации спецнадстройки, шасси и комплектующих изделий.</p>
      <p>Гарантийные обязательства на базовое шасси предоставляет его завод-изготовитель, ПАО «КАМАЗ» или АЗ «Урал». Гарантию на шины, аккумуляторные батареи и прочие покупные комплектующие изделия стороннего производства несут производители или поставщики этих изделий.</p>
    </div>
  {% endcall %}

  {{ band("DSC_0126.webp") }}

  {% call sec("Что не входит в гарантию", "svc-excluded", "Исключения из гарантийных обязательств.", true) %}
    <ul class="ip__tiles ip__tiles--2">
      <li class="ip__tile"><h3 class="ip__tile-title">Расходные материалы</h3><p class="ip__tile-text">Расходники и комплектующие, которые меняют при плановом техническом обслуживании.</p></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Износ</h3><p class="ip__tile-text">Шины, амортизаторы, сайлентблоки, вышедшие из строя из-за естественного износа и условий эксплуатации.</p></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Нарушение правил</h3><p class="ip__tile-text">Неисправности из-за незнания или несоблюдения правил эксплуатации техники и её составных частей.</p></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Без согласования</h3><p class="ip__tile-text">Эксплуатация не по назначению, нарушение Руководства и Сервисной книжки, изменения конструкции без согласования с заводом.</p></li>
    </ul>
    <div class="prose"><p>Подробно об условиях: <a href="/blog-garantiya-chto-pokryvaet.html">«Гарантия на технику: что покрывает завод, а что нет»</a>.</p></div>
  {% endcall %}

  {% call sec("Обслуживание и запчасти", "svc-service", "Регулярное ТО сохраняет гарантию и продлевает ресурс.") %}
    <ul class="ip__tiles ip__tiles--3">
      <li><a class="ip__tile" href="/blog-to-cisterny-chto-i-kogda.html"><span class="ip__tile-meta">Чек-лист</span><span class="ip__tile-title">Техническое обслуживание</span><span class="ip__tile-text">Что проверять перед рейсом, по пробегу и по сезонам.</span></a></li>
      <li><a class="ip__tile" href="/blog-zimnyaya-ekspluataciya-cisterny.html"><span class="ip__tile-meta">Сезон</span><span class="ip__tile-title">Зимняя эксплуатация</span><span class="ip__tile-text">Пневмосистема, подогрев, арматура и электрика.</span></a></li>
      <li><a class="ip__tile" href="/blog-tipichnye-oshibki-ekspluatacii.html"><span class="ip__tile-meta">Опыт</span><span class="ip__tile-title">Типичные ошибки</span><span class="ip__tile-text">Что сокращает срок службы и как этого избежать.</span></a></li>
    </ul>
    <div class="prose">
      <p>Склад запчастей сокращает простои техники. Для заказа запчастей и консультации сервисной службы позвоните по телефону <a href="tel:88001012200">8 (800) 101-22-00</a> или напишите на <a href="mailto:1@bik55.ru">1@bik55.ru</a>. Укажите модель, год выпуска и описание неисправности.</p>
    </div>
  {% endcall %}

  {% call sec("Вопросы", "svc-faq", "Частые вопросы о гарантии и сервисе.", true) %}
    {{ faq([
      ["Кто отвечает за шасси автоцистерны?", "Гарантию на шасси даёт его производитель, ПАО «КАМАЗ» или АЗ «Урал». Обслуживание проходит у их дилеров."],
      ["Что делать при неисправности?", "Сообщите на завод и не продолжайте эксплуатацию, если это небезопасно. Подготовьте документы на технику и описание проблемы."],
      ["Как не потерять гарантию?", "Проводите обслуживание по сервисной книжке, не меняйте конструкцию без согласования с заводом и не перегружайте оси."],
      ["Есть ли запчасти на складе?", "Да, склад запчастей сокращает простои. Для заказа назовите модель и перечень деталей."]
    ], "svc-faq") }}
  {% endcall %}

  {{ cta("Нужен<br />сервис", "Опишите проблему или задайте вопрос по обслуживанию. Свяжемся и поможем.", "Задать вопрос") }}
</article>
{% endblock %}

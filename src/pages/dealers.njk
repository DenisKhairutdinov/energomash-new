{% extends "layout.njk" %}
{% set pagePath = "/dealers.html" %}
{% set pageTitle = "Дилерам: стать партнёром Энергомаш" %}
{% set pageDescription = "Дилерская программа завода «Энергомаш»: как стать дилером, какие материалы и поддержку получает партнёр, как оставить заявку на сотрудничество." %}
{% set currentPage = "terms/dealers" %}
{% set pageClass = "inner" %}
{% block content %}
{% from "ip.njk" import head, sec, cta, crumbs, faq, band %}
<article class="ip">
  {{ crumbs([["Условия", "/terms.html"], ["Дилерам", "/dealers.html"]]) }}
  {{ head("Дилерам", "Завод принимает заявки от компаний, которые хотят продавать технику «Энергомаш» в своём регионе. Условия обсуждаем индивидуально.", '<a href="/terms.html">Условия</a>', false, "IMG_2494.webp", "split-r") }}

  {% call sec("Кому подходит программа", "dealers-who", "У кого есть выход на покупателей спецтехники.") %}
    <ul class="ip__tiles ip__tiles--3">
      <li class="ip__tile"><h3 class="ip__tile-title">Продавцы техники</h3><p class="ip__tile-text">Компании по продаже и обслуживанию грузовой и специальной техники.</p></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Лизинг и сервис</h3><p class="ip__tile-text">Лизинговые и сервисные компании с собственной клиентской базой.</p></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Поставщики оборудования</h3><p class="ip__tile-text">Региональные поставщики для нефтяной, коммунальной и сельскохозяйственной сфер.</p></li>
    </ul>
  {% endcall %}

  {{ band("IMG_0619.webp") }}

  {% call sec("Что получает дилер", "dealers-get", "Поддержка завода на всех этапах.", true) %}
    <ul class="ip__tiles ip__tiles--2">
      <li class="ip__tile"><h3 class="ip__tile-title">Каталог и наличие</h3><p class="ip__tile-text">Доступ к каталогу, складу и срокам изготовления.</p></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Консультации инженеров</h3><p class="ip__tile-text">Помощь с комплектацией и подбором техники под задачу клиента.</p></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Коммерческие предложения</h3><p class="ip__tile-text">Расчёты, спецификации и документы для ваших покупателей.</p></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Гарантия и сервис</h3><p class="ip__tile-text">Информация об обязательствах завода и запчасти для клиентов.</p></li>
    </ul>
  {% endcall %}

  {% call sec("Как стать дилером", "dealers-steps", "Четыре шага до партнёрства.") %}
    <ol class="ip__tiles ip__tiles--4">
      <li class="ip__tile"><span class="ip__tile-num" aria-hidden="true">1</span><h3 class="ip__tile-title">Заявка</h3><p class="ip__tile-text">Расскажите о компании: регион, направление, клиенты.</p></li>
      <li class="ip__tile"><span class="ip__tile-num" aria-hidden="true">2</span><h3 class="ip__tile-title">Обсуждение</h3><p class="ip__tile-text">Менеджер уточнит задачи и предложит формат сотрудничества.</p></li>
      <li class="ip__tile"><span class="ip__tile-num" aria-hidden="true">3</span><h3 class="ip__tile-title">Договор</h3><p class="ip__tile-text">Согласуем условия поставки и работы в регионе.</p></li>
      <li class="ip__tile"><span class="ip__tile-num" aria-hidden="true">4</span><h3 class="ip__tile-title">Запуск</h3><p class="ip__tile-text">Передаём материалы и цены, помогаем с первыми сделками.</p></li>
    </ol>
    <div class="prose"><p>Подробнее: <a href="/blog-kak-stat-dilerom.html">«Как стать дилером завода»</a>.</p></div>
  {% endcall %}

  {% call sec("Что подготовить к заявке", "dealers-prepare", "Короткий список для первого разговора.") %}
    <ul class="ip__tiles ip__tiles--2">
      <li class="ip__tile"><h3 class="ip__tile-title">О компании</h3><p class="ip__tile-text">Чем занимаетесь, как давно работаете, какую технику уже продаёте или обслуживаете.</p></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Регион и отрасли</h3><p class="ip__tile-text">Где работаете и каким клиентам продаёте: нефтегаз, АЗС, водоснабжение, коммунальные службы, сельское хозяйство.</p></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Задачи</h3><p class="ip__tile-text">Какие модели и комплектации интересуют в первую очередь и какой объём закупок планируете.</p></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Финансирование клиентов</h3><p class="ip__tile-text">Нужна ли помощь с лизингом и субсидией для ваших покупателей: <a href="/leasing.html">условия лизинга</a>, <a href="/subsidies.html">субсидия</a>.</p></li>
    </ul>
  {% endcall %}

  {% call sec("С чем работает дилер", "dealers-products", "Направления техники в каталоге.", true) %}
    <div class="prose">
      <p>В каталоге {{ home.catalogTotals.total }} моделей: полуприцепы-цистерны и автоцистерны для топлива, нефти, технической и питьевой воды, вакуумная и коммунальная техника. Техника из наличия отгружается за несколько дней, изготовление под заказ занимает от четырёх недель. Подробнее о каждом направлении: <a href="/benzovozy.html">бензовозы</a>, <a href="/neftevozy.html">нефтевозы</a>, <a href="/vodovozy.html">водовозы</a>, <a href="/vakuumnye-cisterny.html">вакуумные цистерны</a>, <a href="/avtotoplivozapravschiki.html">автотопливозаправщики</a>.</p>
      <p>Чтобы разговаривать с клиентами на одном языке, пригодятся наши материалы: <a href="/guide.html">руководство «Как выбрать цистерну»</a> и <a href="/blog-kak-vybrat-polupricep-cisternu-dlya-nefteproduktov.html">чек-лист выбора полуприцепа-цистерны</a>.</p>
    </div>
  {% endcall %}

  {% call sec("Вопросы", "dealers-faq", "Частые вопросы партнёров.") %}
    {{ faq([
      ["Есть ли ограничения по регионам?", "Условия зависят от региона и объёмов, поэтому их обсуждают лично. Укажите регион в заявке."],
      ["Нужно ли закупать технику на склад?", "Формат работы согласуем индивидуально: возможна работа под заказ клиента и с наличием."],
      ["Помогает ли завод с документами для клиентов?", "Да, передаём коммерческие предложения, спецификации и документы на технику."],
      ["Какая гарантия на технику?", "Гарантия завода 12 месяцев со дня продажи или 30 000 км пробега, что наступит раньше. Гарантию на шасси даёт его производитель: <a href='/services.html'>условия гарантии</a>."],
      ["Можно ли участвовать в тендерах вместе с заводом?", "Да, завод готовит технические характеристики, коммерческое предложение и документы на технику: <a href='/tenders.html'>как мы работаем с тендерами</a>."],
      ["Как быстро завод отвечает на заявку?", "Менеджер связывается с вами после получения заявки и уточняет регион, задачи и формат сотрудничества."]
    ], "dealers-faq") }}
  {% endcall %}

  {{ cta("Станьте<br />партнёром", "Оставьте заявку на сотрудничество, и менеджер свяжется с вами.", "Отправить заявку") }}
</article>
{% endblock %}

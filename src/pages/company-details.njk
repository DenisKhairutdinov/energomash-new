      <div><dt>ИНН / КПП</dt><dd>7415011651 / 165001001</dd></div>
      <div><dt>ОГРН</dt><dd>1027401995455</dd></div>
      <div><dt>ОКВЭД</dt><dd>29.10.4 (производство грузовых автомобилей)</dd></div>
    </dl>
  {% endcall %}

  {% call sec("Адреса", "req-address", "Юридический и почтовый адрес.", true) %}
    <dl class="ip__dl ip__dl--2">
      <div><dt>Юридический адрес</dt><dd>423810, Республика Татарстан, г. Набережные Челны, пр. Хасана Туфана, д. 12, оф. 1910</dd></div>

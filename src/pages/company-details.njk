{% extends "layout.njk" %}
{% set pagePath = "/company-details.html" %}
{% set pageTitle = "Реквизиты ООО «Энергомаш»" %}
{% set pageDescription = "Реквизиты ООО «Энергомаш» для договоров и платёжных поручений: ИНН, КПП, ОГРН, юридический адрес, банковские реквизиты." %}
{% set currentPage = "about/company-details" %}
{% set pageClass = "inner" %}
{% block content %}
{% from "ip.njk" import head, sec, cta, crumbs %}
<article class="ip">
  {{ crumbs([["О заводе", "/about.html"], ["Реквизиты", "/company-details.html"]]) }}
  {{ head("Реквизиты", "Данные организации для договоров, счетов и платёжных поручений.", '<a href="/about.html">О заводе</a>') }}

  {% call sec("Организация", "req-org", "Наименование, руководитель, регистрационные данные.") %}
    <dl class="ip__dl ip__dl--2">
      <div><dt>Полное наименование</dt><dd>Общество с ограниченной ответственностью «Предприятие по производству энергосберегающего оборудования «Энергомаш»</dd></div>

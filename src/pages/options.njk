{% extends "layout.njk" %}
{% set pagePath = "/options.html" %}
{% set pageTitle = "Доработки и опции: оборудование ДОПОГ" %}
{% set pageDescription = "Доработки и переоборудование цистерн «Энергомаш»: комплект для перевозки опасных грузов по ДОПОГ, искрогаситель, тахограф, ЭРА-ГЛОНАСС. Цены и нормативные требования." %}
{% set currentPage = "terms/options" %}
{% set pageClass = "inner" %}
{% block content %}
{% from "ip.njk" import head, sec, cta, crumbs, faq %}
<article class="ip">
  {{ crumbs([["Условия", "/terms.html"], ["Доработки и опции", "/options.html"]]) }}
  {{ head("Доработки и опции", "Дооснастим технику под ваши задачи: оборудование для перевозки опасных грузов по ДОПОГ, электрооборудование, контроль скорости, навигация и другое.", '<a href="/terms.html">Условия</a>', false, "IMG_4530.webp", "dark") }}

  {% call sec("Что можно доработать", "opt-what", "Опции для автоцистерн и полуприцепов-цистерн.") %}
    <ul class="ip__tiles ip__tiles--2">
      <li class="ip__tile"><h3 class="ip__tile-title">Автоцистерны</h3><p class="ip__tile-text">Опции, доработки и комплектующие для автоцистерн: насосы, привод, счётчики, раздаточное оборудование, оснащение шасси.</p></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Полуприцепы-цистерны</h3><p class="ip__tile-text">Опции, доработки и комплектующие для полуприцепов: подвеска, оси, термоизоляция, нижний налив, рекуперация паров.</p></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Для перевозки ЛВЖ (ДОПОГ)</h3><p class="ip__tile-text">Набор оборудования, который нужен транспортному средству для допуска к перевозке легковоспламеняющихся жидкостей.</p></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Переоборудование</h3><p class="ip__tile-text">Монтаж навесного оборудования на шасси заказчика и изменение комплектации под задачу.</p></li>
    </ul>
    <div class="prose"><p>Что можно менять в цистерне под техническое задание: <a href="/blog-cisterna-pod-tehzadanie.html">читайте в статье</a>. Про нижний налив и рекуперацию паров: <a href="/blog-nizhniy-nalivi-rekuperaciya-parov.html">как устроены и зачем нужны</a>.</p></div>
  {% endcall %}

  {% call sec("Доработка для перевозки ЛВЖ (ДОПОГ)", "opt-dopog", "Транспортные средства для перевозки опасных грузов должны отвечать требованиям ДОПОГ.", true) %}
    <div class="prose">
      <p>Перевозка опасных грузов на территории России требует соответствия техники правилам ДОПОГ. Ниже оборудование, которое устанавливают при доработке. Состав и комплектацию уточняет менеджер под вашу модель.</p>
    </div>
    <ul class="ip__tiles ip__tiles--2">
      <li class="ip__tile"><h3 class="ip__tile-title">Главный выключатель аккумуляторной батареи</h3></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Искрогаситель</h3></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Искрогаситель с установкой</h3></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Перенос глушителя за кабину водителя</h3></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Защитный кожух топливного бака</h3></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Экранирование электропроводки</h3></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Установка проблесковых маячков</h3></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Пластиковый контейнер для огнетушителя</h3></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Держатель для таблички «Опасный груз»</h3></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Табличка со спецсимволами</h3></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Набор ДОПОГ (ADR)</h3></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Устройство ограничения скорости (УОС) ЛЭДА-СЛ</h3></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Тахограф Штрих-Тахо RUS</h3></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Система ЭРА-ГЛОНАСС</h3></li>
    </ul>
    <div class="callout">
      <p class="callout__title">Важно</p>
      <p>Всем транспортным средствам максимальной массой более 3,5 тонн необходимо устройство ограничения максимальной скорости в соответствии с техническими требованиями Правил ЕЭК ООН №89 и ДОПОГ п. 9.2.5.</p>
    </div>
  {% endcall %}

  {% call sec("Нормативные документы", "opt-docs", "На что опираются требования к перевозке опасных грузов.") %}
    <ul class="ip__tiles ip__tiles--2">
      <li class="ip__tile"><h3 class="ip__tile-title">ДОПОГ</h3><p class="ip__tile-text">Правила перевозки опасных грузов автомобильным транспортом по Европейскому соглашению о международной дорожной перевозке опасных грузов.</p></li>
      <li class="ip__tile"><h3 class="ip__tile-title">ТР ТС 018/2011</h3><p class="ip__tile-text">Технический регламент Таможенного союза о безопасности колёсных транспортных средств.</p></li>
      <li class="ip__tile"><h3 class="ip__tile-title">ГОСТ 33666-2015</h3><p class="ip__tile-text">Технические требования к автомобильным транспортным средствам для транспортирования и заправки нефтепродуктов.</p></li>
      <li class="ip__tile"><h3 class="ip__tile-title">Приказ Минэнерго №232</h3><p class="ip__tile-text">Правила технической эксплуатации нефтебаз (от 19.06.2003).</p></li>
    </ul>
    <div class="prose"><p>Дополнительно действуют внутренние акты организаций, которые производят и перевозят нефть, нефтепродукты, ГСМ и другие огнеопасные жидкости. Подробнее о допуске и документах: <a href="/blog-dopog-i-reglamenty.html">«ДОПОГ и регламенты»</a>.</p></div>
  {% endcall %}

  {% call sec("Вопросы", "opt-faq", "Частые вопросы о доработках.", true) %}
    {{ faq([
      ["Можно ли доработать технику, которая уже куплена?", "Да, доработки выполняются и для уже купленной техники. Изменения нужно согласовать с заводом, иначе можно потерять гарантию и допуск."],
      ["Входит ли оборудование ДОПОГ в базовую комплектацию?", "Состав зависит от модели. Менеджер сверит комплектацию с вашими требованиями и предложит недостающие позиции."],
      ["Как заказать доработку?", "Оставьте заявку и укажите модель и задачу. Менеджер подготовит перечень работ и сроки."]
    ], "opt-faq") }}
  {% endcall %}

  {{ cta("Нужна<br />доработка", "Расскажите, что нужно добавить или изменить. Менеджер подберёт оборудование и согласует сроки.", "Оставить заявку") }}
</article>
{% endblock %}

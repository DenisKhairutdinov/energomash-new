{% extends "layout.njk" %}
{% set pagePath = "/job.html" %}
{% set pageTitle = "Вакансии на заводе Энергомаш" %}
{% set pageDescription = "Работа на заводе «Энергомаш»: производственные площадки в Челябинской области и офисы в Челябинске и Набережных Челнах. Как откликнуться на вакансии." %}
{% set currentPage = "about/job" %}
{% set pageClass = "inner" %}
{% block content %}
{% from "ip.njk" import head, sec, cta, crumbs, faq %}
<article class="ip">
  {{ crumbs([["О заводе", "/about.html"], ["Вакансии", "/job.html"]]) }}
  {{ head("Вакансии", "Присоединяйтесь к команде производителя специальной техники. Завод заинтересован в квалифицированных специалистах и обеспечивает им профессиональный рост.", '<a href="/about.html">О заводе</a>', false, "20210424_161506.webp", "split-r") }}

  {% call sec("О работе у нас", "job-about", "Производитель техники для опасных грузов.") %}
    <div class="prose">
      <p>«Энергомаш» разрабатывает и изготавливает специальную технику для транспортировки опасных грузов. Продукция востребована в любом городе и регионе: цистерны доставляют ГСМ на городские сети автозаправок, перевозят нефть в местах нефтедобычи и переработки. Сферы применения техники очень обширны.</p>
      <p>У предприятия несколько производственных площадок и обособленных подразделений, чтобы сотрудникам было удобно работать. Мы заинтересованы в привлечении квалифицированных специалистов. Обеспечивая профессиональный рост сотрудников, вместе мы достигаем новых уровней в развитии.</p>
    </div>
  {% endcall %}

  {% call sec("Где работаем", "job-where", "Площадки и офисы.", true) %}
    <dl class="ip__dl ip__dl--2 ip__dl--big">
      <div><dt>Производство</dt><dd>Челябинская область, Мисяш</dd></div>
      <div><dt>Офис в Челябинске</dt><dd>ул. Кирова, 159, офис 1709</dd></div>
      <div><dt>Офис в Набережных Челнах</dt><dd>проспект Хасана Туфана, 12, офис 1910</dd></div>
    </dl>
  {% endcall %}

  {% call sec("Как откликнуться", "job-apply", "Отправьте резюме или позвоните.") %}
    <div class="prose">
      <p>Актуальные вакансии уточняйте по телефону <a href="tel:88001012200">8 (800) 101-22-00</a>. Резюме отправляйте на <a href="mailto:1@bik55.ru">1@bik55.ru</a> с темой «Вакансия» и укажите желаемую должность и город.</p>
    </div>
    {{ faq([
      ["Где можно работать?", "На производственной площадке в Челябинской области и в офисах в Челябинске и Набережных Челнах."],
      ["Какие специалисты нужны заводу?", "Квалифицированные специалисты производства, инженеры, менеджеры и сотрудники сервиса. Актуальный список уточняйте по телефону."],
      ["Можно ли отправить резюме без открытой вакансии?", "Да, отправьте резюме на почту. Мы свяжемся, когда появится подходящая позиция."]
    ], "job-faq") }}
  {% endcall %}

  {{ cta("Хотите<br />работать у нас", "Отправьте резюме или позвоните, расскажем об открытых позициях.", "Позвонить мне") }}
</article>
{% endblock %}

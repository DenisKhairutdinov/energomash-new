{% extends "layout.njk" %}
{% set pagePath = "/shipments.html" %}
{% set pageTitle = "Наши отгрузки: цистерны у заказчиков" %}
{% set pageDescription = "Недавние отгрузки завода «Энергомаш»: модели полуприцепов-цистерн и автоцистерн, города и даты поставок заказчикам по России." %}
{% set currentPage = "about/shipments" %}
{% set pageClass = "inner" %}
{% block content %}
{% from "ip.njk" import head, sec, cta, crumbs %}
<article class="ip">
  {{ crumbs([["О заводе", "/about.html"], ["Наши отгрузки", "/shipments.html"]]) }}
  {{ head("Наши отгрузки", "Свежие поставки заказчикам: модели, города и даты отгрузки. Техника «Энергомаш» работает по всей России и за рубежом.", '<a href="/about.html">О заводе</a>', false, "IMG_0550.webp", "plain") }}

  <section class="ip__sec ip__sec--soft" aria-labelledby="ship-title">
    <div class="ip__side">
      <h2 class="section-title ip__h2" id="ship-title">Недавно<br />отгружено</h2>
      <p class="ip__note">Список пополняется по мере отгрузок. Хотите увидеть свою технику здесь? Скажите менеджеру при заказе.</p>
    </div>
    <div class="ip__body">
      <ul class="bl__list bl__list--plain">
        {% for item in home.shipments %}
          <li>
            <div class="bl__card">
              <img class="bl__image" src="/src/assets/images/{{ item.image }}" width="1024" height="768" alt="{{ item.type }} {{ item.model }}, отгрузка в {{ item.city }}" loading="lazy" decoding="async" />
              <span class="bl__meta"><time datetime="{{ item.datetime }}">{{ item.date }}</time>, {{ item.city }}</span>
              <span class="bl__text">
                <span class="bl__title">{{ item.model }}</span>
                <span class="bl__excerpt">{{ item.type }}. {% for spec in item.specs %}{{ spec[0] }} {{ spec[1] }}{% if not loop.last %} · {% endif %}{% endfor %}</span>
              </span>
            </div>
          </li>
        {% endfor %}
      </ul>
    </div>
  </section>

  {% call sec("Что отгружаем", "ship-types", "Техника, которая чаще всего уходит заказчикам.", true) %}
    <ul class="ip__tiles ip__tiles--3">
      <li><a class="ip__tile" href="/benzovozy.html"><span class="ip__tile-title">Бензовозы и нефтевозы</span><span class="ip__tile-text">Полуприцепы-цистерны для топлива и нефти.</span></a></li>
      <li><a class="ip__tile" href="/vodovozy.html"><span class="ip__tile-title">Водовозы</span><span class="ip__tile-text">Цистерны для технической и питьевой воды.</span></a></li>
      <li><a class="ip__tile" href="/avtotoplivozapravschiki.html"><span class="ip__tile-title">Автотопливозаправщики</span><span class="ip__tile-text">Заправка техники на объектах.</span></a></li>
      <li><a class="ip__tile" href="/vakuumnye-cisterny.html"><span class="ip__tile-title">Вакуумные цистерны</span><span class="ip__tile-text">Сбор нефти, шлама и технологических жидкостей.</span></a></li>
      <li><a class="ip__tile" href="/kommunalnye-vakuumnye-mashiny.html"><span class="ip__tile-title">Коммунальные машины</span><span class="ip__tile-text">Откачка септиков, колодцев и сетей.</span></a></li>
      <li><a class="ip__tile" href="/catalog.html?in-stock=1"><span class="ip__tile-title">Из наличия</span><span class="ip__tile-text">Модели, которые стоят на складе и уходят за несколько дней.</span></a></li>
    </ul>
  {% endcall %}

  {% call sec("Как проходит отгрузка", "ship-steps", "От приёмки до передачи техники.") %}
    <ol class="ip__tiles ip__tiles--3">
      <li class="ip__tile"><span class="ip__tile-num" aria-hidden="true">1</span><h3 class="ip__tile-title">Приёмка</h3><p class="ip__tile-text">Покупатель или его представитель проверяет технику на заводе, при необходимости по фото и видео: <a href="/blog-priemka-tehniki-na-zavode.html">как это устроено</a>.</p></li>
      <li class="ip__tile"><span class="ip__tile-num" aria-hidden="true">2</span><h3 class="ip__tile-title">Документы</h3><p class="ip__tile-text">Паспорт, ОТТС, сертификаты, гарантийный талон, сервисная книжка и руководство передаются вместе с техникой.</p></li>
      <li class="ip__tile"><span class="ip__tile-num" aria-hidden="true">3</span><h3 class="ip__tile-title">Доставка</h3><p class="ip__tile-text">Полуприцепы доезжают с тягачом заказчика, автоцистерны своим ходом или транспортной компанией: <a href="/delivery.html">условия доставки</a>.</p></li>
    </ol>
  {% endcall %}

  {% call sec("Куда поставляем", "ship-geo", "Регионы России и зарубежные страны.", true) %}
    <div class="prose"><p>Техника «Энергомаш» работает от Урала до Дальнего Востока и поставляется за рубеж: в страны Азии, Центральной Африки и на Кубу. Карта регионов, куда поставлена техника, на странице <a href="/company.html">«О компании»</a>.</p></div>
  {% endcall %}

  {{ cta("Закажите<br />свою цистерну", "Подберём технику из наличия или изготовим под ваше задание.", "Оставить заявку") }}
</article>
{% endblock %}
